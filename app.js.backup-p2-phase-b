function copyShareText() {
  const primary = state.resultPersonality;
  const secondary = state.secondaryPersonality;
  const primaryScore = state.matchResults[0].matchScore;
  const secondaryScore = state.matchResults[1].matchScore;
  const gap = state.confidenceGap;
  const text = generateShareText(primary, secondary, primaryScore, secondaryScore, gap, state.avgDimensionScores);

  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(() => {
      showCopyToast('已复制分享文字，去发给朋友吧');
    }).catch(() => { fallbackCopy(text); });
  } else {
    fallbackCopy(text);
  }
}

function fallbackCopy(text) {
  const ta = document.createElement('textarea');
  ta.value = text; ta.style.cssText = 'position:fixed;left:-9999px;';
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); showCopyToast('已复制分享文字，去发给朋友吧'); }
  catch(e) { showCopyToast('复制失败，请截图保存'); }
  document.body.removeChild(ta);
}

function showCopyToast(msg) {
  let toast = $('#copy-toast');
  if (!toast) {
    toast = document.createElement('div');
    toast.id = 'copy-toast';
    document.body.appendChild(toast);
  }
  toast.textContent = msg;
  toast.classList.add('show');
  clearTimeout(toast._timeout);
  toast._timeout = setTimeout(() => toast.classList.remove('show'), 2200);
}

