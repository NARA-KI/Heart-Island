};

function isCoreType(personalityOrId) {
  const id = typeof personalityOrId === 'string' ? personalityOrId : personalityOrId.id;
  return CORE_TYPE_IDS.includes(id);
}

function isBranchType(personalityOrId) {
  const id = typeof personalityOrId === 'string' ? personalityOrId : personalityOrId.id;
  return BRANCH_TYPE_IDS.includes(id);
}

function getParentTypeId(branchId) {
  return BRANCH_PARENT_MAP[branchId] || null;
}

// ============================================
// 2c. BRANCH → CORE NORMALIZE UTILITIES (Beta 0.9.9)
// ============================================
// Resolve a personality name (could be branch) to its core name.
// Core names pass through unchanged; branch names map to their core parent.
function normalizeTypeNameToCore(name) {
  const p = personalities.find(pp => pp.name === name);
  if (!p) return name; // unknown name, pass through
  if (isCoreType(p)) return name;
  const parentId = BRANCH_PARENT_MAP[p.id];
  if (!parentId) return name;
  const parent = personalities.find(pp => pp.id === parentId);
  return parent ? parent.name : name;
}

// Resolve an array of personality names to core-only, deduplicated.
function normalizeNameListToCore(names) {
  const coreNames = names.map(n => normalizeTypeNameToCore(n));
  return [...new Set(coreNames)];
}

// Resolve a compat object (keys may include branch names) to core-only.
// Merges branch scores into their core parent (taking the max score).
function normalizeCompatToCore(compat) {
  const result = {};
  for (const [name, score] of Object.entries(compat)) {
    const coreName = normalizeTypeNameToCore(name);
    if (!result[coreName] || score > result[coreName]) {
      result[coreName] = score;
    }
  }
  return result;
}

