function generateJourneyNarrative(choiceHistory) {
  if (choiceHistory.length === 0) return '';

  // Pick top 6 most impactful choices
  const picks = choiceHistory
    .map(c => ({ c, impact: c.score }))
    .sort((a,b) => b.impact - a.impact)
    .slice(0, 6)
    .map(e => e.c);

  const opening = '你走过的12个心岛地点，每一个都在悄悄描摹着你独有的恋爱轮廓。';

  let narrative = `<p class="journey-intro">${opening}</p>`;

  for (const p of picks) {
    const locName = DIM_META[p.dimension] ? DIM_META[p.dimension].location : '';
    const locIcon = DIM_META[p.dimension] ? DIM_META[p.dimension].icon : '';
    narrative += `<p class="journey-line">在<strong>${locIcon} ${locName}</strong>——${p.sceneTitle}，你选择了<strong>"${p.optionText}"</strong>。${p.memoryTag}。</p>`;
  }

  narrative += `<p class="journey-closing">这6个瞬间不足以概括你的全部，但它们像6颗最亮的星星——当你看它们连成的形状时，你会看见自己。</p>`;

  return narrative;
}

// ============================================
// 9. SCORE REASON (WHY THIS TYPE)
// ============================================
function generateScoreReason(personality, avgDimensionScores) {
  const keyDims = personality.keyDimensions || DIM_ORDER.slice(0, 6);
  const footprintExplanations = [];

  for (const dim of keyDims) {
    const meta = DIM_META[dim];
    const score = getScore(avgDimensionScores, dim);
    const insight = generateDimensionInsight(dim, score);
    footprintExplanations.push({
      dim, meta, score, insight,
      level: score >= 70 ? 'high' : score >= 40 ? 'mid' : 'low'
    });
  }

  // Build the reason text — group by high/low
  const highs = footprintExplanations.filter(f => f.level === 'high');
  const lows = footprintExplanations.filter(f => f.level === 'low');
  const mids = footprintExplanations.filter(f => f.level === 'mid');

  // ---- Exclusion reasoning: which types were ruled out by low dimensions ----
  const exclusionItems = [];
  for (const f of lows) {
    const excludedTypes = personalities.filter(p => {
      if (p.id === personality.id) return false;
      const thresholds = p.coreThresholds || {};
      if (thresholds[f.dim] && thresholds[f.dim] >= 65) return true;
      if (getScore(p.targetVector, f.dim) >= 75) return true;
      return false;
    });
    if (excludedTypes.length > 0) {
      const typeNames = excludedTypes.slice(0, 3).map(t => t.name).join('、');
      const suffix = excludedTypes.length > 3 ? `等${excludedTypes.length}种类型` : '';
      exclusionItems.push({
        dim: f.dim,
        meta: f.meta,
        score: f.score,
        insight: f.insight,
        excludedNames: typeNames + suffix,
        excludedCount: excludedTypes.length
      });
    }
  }

  // Personality clue summary
  const personalityClues = {
    lighthouse: '这些特征叠加在一起，构成了灯塔型最明显的底色：你习惯成为关系里那个先亮起来的人，用行动而非言语来爱。',
