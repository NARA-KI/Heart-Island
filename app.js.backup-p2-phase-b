function initFeedbackForm() {
  const form = $('#feedback-section');
  if (!form) return;

  // Track selected radio-like options
  const selections = {};

  form.addEventListener('click', (e) => {
    const optBtn = e.target.closest('.fb-opt-btn');
    if (optBtn) {
      const parent = optBtn.parentElement;
      const fbKey = parent.dataset.fb;
      parent.querySelectorAll('.fb-opt-btn').forEach(b => b.classList.remove('selected'));
      optBtn.classList.add('selected');
      selections[fbKey] = optBtn.dataset.val;
    }
  });

  // Beta 0.9.9.3: Expand toggle for text feedback fields
  const expandToggle = $('#fb-expand-toggle');
  const textFields = $('#fb-text-fields');
  if (expandToggle && textFields) {
    expandToggle.addEventListener('click', () => {
      const expanded = textFields.classList.contains('expanded');
      if (expanded) {
        textFields.classList.remove('expanded');
        expandToggle.textContent = '补充反馈▾';
      } else {
        textFields.classList.add('expanded');
        expandToggle.textContent = '收起反馈▴';
      }
    });
  }

  const submitBtn = $('#fb-submit-btn');
  if (submitBtn) {
    submitBtn.addEventListener('click', () => {
      const feedback = {
        accuracy: selections['accuracy'] || '',
        accurateParts: (form.querySelector('[data-fb="accurateParts"]') || {}).value || '',
        inaccurateParts: (form.querySelector('[data-fb="inaccurateParts"]') || {}).value || '',
        uxIssues: (form.querySelector('[data-fb="uxIssues"]') || {}).value || '',
        wouldShare: selections['wouldShare'] || '',
        primaryType: state.resultPersonality ? state.resultPersonality.name : '',
        secondaryType: state.secondaryPersonality ? state.secondaryPersonality.name : '',
        gap: state.confidenceGap,
        version: '0.9.9.3'
      };
      saveFeedback(feedback);

      submitBtn.classList.add('hidden');
      const thanks = $('#fb-thanks');
      if (thanks) thanks.classList.remove('hidden');
    });
  }

  const copyBtn = $('#fb-copy-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const primary = state.resultPersonality;
      const secondary = state.secondaryPersonality;
      const primaryScore = state.matchResults[0] ? state.matchResults[0].matchScore : 0;
      const secondaryScore = state.matchResults[1] ? state.matchResults[1].matchScore : 0;
      const gap = state.confidenceGap;
      const avgScores = state.avgDimensionScores || {};

      const dimLines = DIM_ORDER.map(d => {
        const meta = DIM_META[d];
        return `  ${meta.icon} ${meta.location}（${d}）：${getScore(avgScores, d)}`;
      }).join('\n');

      const coreTop5 = (state.matchResults || []).slice(0, 5).map((r, i) =>
        `  ${i + 1}. ${r.personality.name} — ${r.matchScore}%`
      ).join('\n');

      const debugTop5 = (state.debugAllTypeMatches || []).slice(0, 5).map((r, i) =>
        `  ${i + 1}. ${r.personality.name} — ${r.matchScore}%`
      ).join('\n');

      const accuracy = selections['accuracy'] || '（未选）';
      const accurateParts = (form.querySelector('[data-fb="accurateParts"]') || {}).value || '（未填）';
      const inaccurateParts = (form.querySelector('[data-fb="inaccurateParts"]') || {}).value || '（未填）';
      const uxIssues = (form.querySelector('[data-fb="uxIssues"]') || {}).value || '（未填）';
      const wouldShare = selections['wouldShare'] || '（未选）';

      const text = `心岛计划 Beta 0.9.9.3 — 反馈数据
═══════════════════════════════
主岛：${primary ? primary.name : '?'}  ${primaryScore}%
关系回声：${(secondary && gap <= 12) ? secondary.name : '（无明显回声）'}  ${secondaryScore}%
主岛分差（gap）：${gap}

12维分数：
${dimLines}

12核心 Top 5：
${coreTop5}

Debug - 全20类型 Top 5：
${debugTop5}

用户反馈：
  准度：${accuracy}
  哪里准：${accurateParts}
  哪里不准：${inaccurateParts}
  重复/看不懂：${uxIssues}
  愿意分享：${wouldShare}
═══════════════════════════════`;

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          showCopyToast('✅ 已复制，请发给测试发起人');
        }).catch(() => { fallbackCopy(text); });
      } else {
        fallbackCopy(text);
      }
    });
  }
}

