function synthesizePersonaDescription(primary) {
  if (PERSONA_DESCRIPTIONS[primary.id]) return PERSONA_DESCRIPTIONS[primary.id];
  const moments = primary.resonanceMoments || [];
  if (moments.length >= 2) return moments.slice(0, 2).join('').substring(0, 150) + '…';
  return (primary.loveMode || primary.portrait || '').substring(0, 150);
}

function synthesizeNeedDescription(primary) {
  if (NEED_DESCRIPTIONS[primary.id]) return NEED_DESCRIPTIONS[primary.id];
  const raw = (primary.hiddenNeed || '');
  return raw.replace(/^你需要/, '其实').replace(/你渴望/, '让你安心的是').substring(0, 135);
}

function synthesizeWhyLines(avgScores, primary) {
  const keyDims = primary.keyDimensions || [];
  const dimEntries = keyDims.map(dim => ({
    dim, meta: DIM_META[dim], score: getScore(avgScores, dim)
  }));
  if (dimEntries.length === 0) return '<p class="manual-why-line">你的心岛地图正在绘制中。</p>';

  dimEntries.sort((a, b) => b.score - a.score);
  const top = dimEntries[0];
  const mid = dimEntries[Math.floor(dimEntries.length / 2)];
  const bottom = dimEntries[dimEntries.length - 1];

  const lines = [];
  if (top) {
    const loc = top.meta ? top.meta.location : top.dim;
    lines.push(`<p class="manual-why-line">你在<strong>${loc}</strong>上的得分最高（${top.score}），你对${top.meta ? top.meta.label : ''}的倾向让${primary.name}的特质和你产生了强烈的呼应。</p>`);
  }
  if (mid && mid.dim !== top.dim) {
    const loc = mid.meta ? mid.meta.location : mid.dim;
    lines.push(`<p class="manual-why-line">而你在<strong>${loc}</strong>上的取舍，恰好解释了为什么你更接近${primary.name}，而不是其他相近的类型。</p>`);
  }
  if (bottom && bottom.dim !== top.dim && bottom.dim !== (mid ? mid.dim : '')) {
    const loc = bottom.meta ? bottom.meta.location : bottom.dim;
    lines.push(`<p class="manual-why-line">你在<strong>${loc}</strong>上得分不高（${bottom.score}），这恰好排除了那些需要该维度高分的类型，让${primary.name}成为最像你的归宿。</p>`);
  }
  return lines.join('');
}

