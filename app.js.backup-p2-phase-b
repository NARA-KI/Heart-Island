const STORAGE_KEY = 'heart_island_last_result';

function saveResultToLocal() {
  const primary = state.resultPersonality;
  const secondary = state.secondaryPersonality;
  if (!primary) return;

  const data = {
    timestamp: new Date().toISOString(),
    version: '0.9.9.3',
    primaryName: primary.name,
    primaryId: primary.id,
    primaryScore: state.matchResults[0] ? state.matchResults[0].matchScore : 0,
    secondaryName: secondary ? secondary.name : '',
    secondaryId: secondary ? secondary.id : '',
    secondaryScore: state.matchResults[1] ? state.matchResults[1].matchScore : 0,
    gap: state.confidenceGap,
    avgScores: state.avgDimensionScores,
    coreTop5: (state.matchResults || []).slice(0, 5).map(r => ({
      name: r.personality.name,
      id: r.personality.id,
      score: r.matchScore
    })),
    debugAllTypeTop5: (state.debugAllTypeMatches || []).slice(0, 5).map(r => ({
      name: r.personality.name,
      id: r.personality.id,
      score: r.matchScore
    })),
    choiceHistory: state.choiceHistory,
    primaryHitLine: primary.hitLine || '',
    primaryPortrait: primary.portrait || '',
    primaryKeywords: primary.keywords || [],
    primarySubtitle: primary.subtitle || '',
    primaryArchetype: primary.archetype || '',
    primaryShareQuote: primary.shareQuote || ''
  };

  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
  } catch (e) {
    console.warn('localStorage 保存失败，可能空间不足');
  }
}

function loadSavedResult() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return null;
    return JSON.parse(raw);
  } catch (e) {
    return null;
  }
}

function clearSavedResult() {
  localStorage.removeItem(STORAGE_KEY);
}

function checkSavedResultNotice() {
  const saved = loadSavedResult();
  if (!saved) return;

  const notice = $('#saved-result-notice');
  if (!notice) return;

  const timeStr = new Date(saved.timestamp).toLocaleString('zh-CN', {
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit'
  });

  notice.innerHTML = `
    <p class="saved-notice-text">你上次的测试结果：<strong>${saved.primaryName}</strong>（${saved.primaryScore}%）</p>
    <p class="saved-notice-time">测试时间：${timeStr}</p>
    <div class="saved-notice-buttons">
      <button id="view-saved-btn" class="saved-notice-btn">查看上次结果</button>
      <button id="retake-btn" class="saved-notice-btn retake">重新测试</button>
    </div>
    <p class="saved-notice-warning">结果仅保存在当前设备和浏览器中，清理缓存后会消失。</p>
  `;
  notice.classList.remove('hidden');
  setTimeout(() => notice.classList.add('visible'), 400);

  // View saved result
  const viewBtn = $('#view-saved-btn');
  if (viewBtn) {
    viewBtn.addEventListener('click', () => {
      // Restore state from saved data and jump to result
      restoreStateFromSaved(saved);
      startExploring();
    });
  }

  // Retake (just hide notice and start normally)
  const retakeBtn = $('#retake-btn');
  if (retakeBtn) {
    retakeBtn.addEventListener('click', () => {
      notice.classList.add('hidden');
      notice.classList.remove('visible');
      // Start button already works normally
    });
  }
}

function restoreStateFromSaved(saved) {
  // Restore enough state to render the result page
  state.avgDimensionScores = saved.avgScores || {};
  state.choiceHistory = saved.choiceHistory || [];
  state.confidenceGap = saved.gap || 0;

  // Find the personality objects
  const primaryP = personalities.find(p => p.id === saved.primaryId);
  const secondaryP = personalities.find(p => p.id === saved.secondaryId);

  if (primaryP) {
    state.resultPersonality = primaryP;
    // Rebuild match results from coreTop5 (Beta 0.9.7) or top5 (legacy)
    const top5Data = saved.coreTop5 || saved.top5 || [];
    state.matchResults = top5Data.map(t5 => {
      const p = personalities.find(pp => pp.id === t5.id);
      return { personality: p || primaryP, matchScore: t5.score };
    });
    if (secondaryP) state.secondaryPersonality = secondaryP;
    else if (state.matchResults[1]) state.secondaryPersonality = state.matchResults[1].personality;
  }
}

function startExploring() {
  state.phase = 'exploring';
  state.currentSceneIndex = displayScenes.length; // Skip to end
  prepareOptionOrders();
  lastLocation = null;
  dom.introScreen.classList.add('hidden');
  dom.gameScreen.classList.add('hidden');
  dom.revealScreen.classList.add('hidden');
  showRevealTransition(); // This will compute results if needed and show result
}

function initResultSaveButtons() {
  const saveBtn = $('#result-save-btn');
  const viewSavedBtn = $('#result-view-saved-btn');
  const clearBtn = $('#result-clear-btn');

  // Show view/clear if there's a saved result
  const saved = loadSavedResult();
  if (saved && viewSavedBtn) viewSavedBtn.classList.remove('hidden');
  if (saved && clearBtn) clearBtn.classList.remove('hidden');

  if (saveBtn) {
    saveBtn.addEventListener('click', () => {
      saveResultToLocal();
      showCopyToast('结果已保存到本地');
      if (viewSavedBtn) viewSavedBtn.classList.remove('hidden');
      if (clearBtn) clearBtn.classList.remove('hidden');
    });
  }

  if (viewSavedBtn) {
    viewSavedBtn.addEventListener('click', () => {
      showCopyToast('已保存的结果在上方页面中，滚动即可查看');
    });
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      clearSavedResult();
      if (viewSavedBtn) viewSavedBtn.classList.add('hidden');
      if (clearBtn) clearBtn.classList.add('hidden');
      showCopyToast('本地结果已清除');
    });
  }
}

