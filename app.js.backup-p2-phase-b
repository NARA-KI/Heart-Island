// parentType mapping: each branch type points to one of the 12 core types
const BRANCH_PARENT_MAP = {
  old_captain:   'collector',       // 旧船长型 → 收藏家型
  script_writer: 'wandering_poet',  // 剧本型 → 流浪诗人型
