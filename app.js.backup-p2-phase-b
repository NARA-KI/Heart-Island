function getTopBottomDimensions(avgDimensionScores) {
  const entries = DIM_ORDER.map(dim => ({
    dim,
    score: getScore(avgDimensionScores, dim),
    meta: DIM_META[dim]
  }));
  entries.sort((a,b) => b.score - a.score);
  return {
    top: entries.slice(0, 3),
    bottom: entries.slice(-2).reverse()
  };
}

