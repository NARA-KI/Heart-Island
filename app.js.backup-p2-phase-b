        // Update toggle text to "expand" variant
        const arrow = btn.querySelector('.toggle-arrow');
        if (arrow) arrow.textContent = '▾';
      } else {
        content.classList.add('expanded');
        btn.classList.add('expanded');
        const arrow = btn.querySelector('.toggle-arrow');
        if (arrow) arrow.textContent = '▴';
      }
    });
  });
}

