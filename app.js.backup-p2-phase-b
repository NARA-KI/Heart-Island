function toggleDebugPanel() {
  let panel = $('#debug-panel');
  if (panel.classList.contains('hidden')) {
    panel.classList.remove('hidden');
    updateDebugContent();
  } else {
    panel.classList.add('hidden');
  }
}

function updateDebugContent() {
  const content = $('#debug-content');
  if (!content) return;

  const avgScores = state.avgDimensionScores || {};
  const matchResults = state.matchResults || [];
  const feedbacks = getFeedbacks();

  const dimScoresHTML = DIM_ORDER.map(dim => {
    const meta = DIM_META[dim];
    const score = getScore(avgScores, dim);
    return `<span class="debug-score">${meta.icon}${score}</span>`;
  }).join(' ');

  const top5HTML = matchResults.slice(0, 5).map((r, i) =>
    `<div class="debug-rank">#${i+1} ${r.personality.name} <span class="debug-ms">${r.matchScore}分</span></div>`
  ).join('');

  const primary = state.resultPersonality;
  const secondary = state.secondaryPersonality;

  content.innerHTML = `
    <div class="debug-section">
      <strong>🎯 结果</strong>
      <div>主岛: ${primary ? primary.name : '—'} | 关系回声: ${secondary ? secondary.name : '—'} | gap: ${state.confidenceGap || '—'}</div>
    </div>
    <div class="debug-section">
      <strong>📊 12维分数</strong>
      <div class="debug-scores">${dimScoresHTML}</div>
    </div>
    <div class="debug-section">
      <strong>🏆 Top 5 排名</strong>
      ${top5HTML}
    </div>
    <div class="debug-section">
      <strong>📋 反馈记录 (${feedbacks.length}条)</strong>
      ${feedbacks.length > 0 ? feedbacks.map((fb, i) =>
        `<div class="debug-fb">#${i+1}: ${fb.primaryType}/${fb.secondaryType} | 准度:${fb.accuracy} | 分享:${fb.wouldShare}</div>`
      ).join('') : '<div class="debug-empty">暂无反馈</div>'}
    </div>
    <button class="debug-export-btn" id="debug-export-btn">📥 导出 JSON</button>
    <button class="debug-export-btn" id="debug-clear-btn" style="background:rgba(201,112,124,0.15);border-color:var(--rose);color:var(--rose-glow);">🗑️ 清空反馈</button>
  `;

  // Export button
  const exportBtn = $('#debug-export-btn');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const dump = {
        avgDimensionScores: avgScores,
        primaryType: primary ? { id: primary.id, name: primary.name } : null,
        secondaryType: secondary ? { id: secondary.id, name: secondary.name } : null,
        confidenceGap: state.confidenceGap,
        top5: matchResults.slice(0, 5).map(r => ({ name: r.personality.name, score: r.matchScore })),
        feedbacks,
        exportedAt: new Date().toISOString()
      };
      const blob = new Blob([JSON.stringify(dump, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'heart-island-debug-' + new Date().toISOString().slice(0,10) + '.json';
      a.click(); URL.revokeObjectURL(url);
      showCopyToast('✅ 已导出 JSON');
    });
  }

  // Clear feedback button
  const clearBtn = $('#debug-clear-btn');
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      localStorage.removeItem('heart_island_feedback');
      updateDebugContent();
      showCopyToast('🗑️ 反馈已清空');
    });
  }
}

