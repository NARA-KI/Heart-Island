// ============================================
// 8c. SUB-ISLAND INSIGHT GENERATOR
// ============================================
function generateSubIslandInsight(subType, avgScores, mainType, gap) {
  const subKeyDims = (subType.keyDimensions || []).slice(0, 3);
  const mainKeyDims = mainType ? (mainType.keyDimensions || []) : [];

  // Build the echo insight for sub-type
  const lines = subKeyDims.map(dim => {
    const meta = DIM_META[dim];
    const score = getScore(avgScores, dim);
    return generateDimensionInsight(dim, score);
  }).filter(Boolean);

  const portraitSnippet = subType.portrait ? subType.portrait.substring(0, 100) : '';
  const insightText = lines.length > 0 ? lines.join('') : '';
  const echoPart = `${subType.name}说明，${portraitSnippet}${insightText}`;

  // ---- Complement / Conflict analysis between main and sub ----
  if (!mainType) return echoPart;

  const mainVec = mainType.targetVector || {};
  const subVec = subType.targetVector || {};

  // Find where main and sub converge (both high or both low)
  const convergeHigh = []; // both types score high — reinforcement
  const convergeLow = [];  // both types score low — shared blind spot
  // Find where they diverge (one high, one low)
  const complementDims = []; // sub fills main's gap — where sub is high but main is neutral/low
  const conflictDims = [];   // main and sub pull in opposite directions

  for (const dim of DIM_ORDER) {
    const mv = getScore(mainVec, dim);
    const sv = getScore(subVec, dim);
    if (mv >= 65 && sv >= 65) {
      convergeHigh.push(dim);
    } else if (mv <= 40 && sv <= 40) {
      convergeLow.push(dim);
    } else if (sv >= 65 && mv <= 45) {
      complementDims.push(dim);
    } else if (Math.abs(mv - sv) >= 30) {
      conflictDims.push(dim);
    }
  }

  // Build natural-language complement/conflict summary
  const parts = [];

  if (convergeHigh.length > 0) {
    const names = convergeHigh.slice(0, 3).map(d => DIM_META[d]?.location || d).join('、');
    parts.push(`${mainType.name}和${subType.name}在<strong>${names}</strong>这些维度上高度一致——你们在这方面的需求天然同频，关系中不太会产生摩擦。`);
  }

  if (complementDims.length > 0) {
    const names = complementDims.slice(0, 2).map(d => DIM_META[d]?.location || d).join('、');
    parts.push(`${subType.name}在<strong>${names}</strong>上恰好弥补了${mainType.name}的不足——回声不是干扰，而是主岛缺失的那块拼图。`);
  }

  if (conflictDims.length > 0) {
    const names = conflictDims.slice(0, 2).map(d => DIM_META[d]?.location || d).join('、');
    parts.push(`但${mainType.name}和${subType.name}在<strong>${names}</strong>上存在明显拉扯——这是你关系中可能出现矛盾的地方，需要双方有意识地沟通和妥协。`);
  }

  if (convergeLow.length > 0 && convergeLow.length <= 4) {
    const names = convergeLow.slice(0, 2).map(d => DIM_META[d]?.location || d).join('、');
    parts.push(`另外，两种类型在<strong>${names}</strong>上都偏谨慎——这是你们共同的盲区，可以一起留意和成长。`);
  }

  const analysisPart = parts.length > 0
    ? `<br><br><span class="complement-title">主岛与关系回声互补与冲突分析：</span><br>` + parts.join('<br>')
    : '';

  return echoPart + analysisPart;
}

