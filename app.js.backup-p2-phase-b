// 14c. RENDER SCENE (Beta 0.9.9 — 12地点场景系统)
// ============================================
function renderScene() {
  if (state.currentSceneIndex >= displayScenes.length) {
    // Transition to ending sequence instead of old reveal
    showEndingSequence();
    return;
  }
  const scene = displayScenes[state.currentSceneIndex];
  const visual = getSceneVisual(scene.id);
  const dimMeta = DIM_META[scene.dimension];
  const done = state.currentSceneIndex + 1;

  // Apply scene background
  applySceneBackground(visual);

  // Update top bar: location name, dimension, question counter
  if (dom.sceneLocationName) dom.sceneLocationName.textContent = scene.location;
  if (dom.sceneDimensionLabel) dom.sceneDimensionLabel.textContent = (dimMeta ? dimMeta.label : '');
  if (dom.sceneQuestionCounter) {
    dom.sceneQuestionCounter.textContent = String(done).padStart(2, '0') + ' / 36';
  }

  // Update 12-location progress bar
  renderLocationProgress(state.currentSceneIndex);

  // Chapter hint on new location
  if (scene.location !== lastLocation) {
    lastLocation = scene.location;
    showChapterHint(scene.location);
  }

  // Mood text (subtle, above title)
  if (dom.sceneMood) {
    dom.sceneMood.textContent = scene.location + ' · ' + scene.title;
  }

  dom.sceneTitle.textContent = scene.title;
  dom.sceneNarrative.textContent = scene.text;
  dom.optionsContainer.innerHTML = '';

  // Card enter animation
  dom.sceneCard.classList.remove('exiting');
  dom.sceneCard.classList.add('enter');

  // Show/hide previous button
  if (dom.prevBtn) {
    if (state.currentSceneIndex > 0) {
      dom.prevBtn.classList.remove('hidden');
    } else {
      dom.prevBtn.classList.add('hidden');
    }
  }

  // Render option buttons
  const prevChoice = state.choiceHistory.find(c => c.sceneId === scene.id);
  const orderedOptions = state.optionOrderByScene[scene.id] || scene.options;
  orderedOptions.forEach((opt, displayIdx) => {
    const btn = document.createElement('button');
    btn.className = 'option-btn';
    const routeNum = String(displayIdx + 1).padStart(2, '0');
    btn.innerHTML = `<span class="route-number">${routeNum}</span><span class="route-beacon"></span><span class="opt-text">${opt.text}</span><span class="route-trail">→</span>`;
    btn.addEventListener('click', () => selectOption(scene, opt, displayIdx));
    dom.optionsContainer.appendChild(btn);

    if (prevChoice && prevChoice.optionId === opt.id) {
      setTimeout(() => { btn.classList.add('flash-select'); }, 50);
    }
    setTimeout(() => { btn.classList.add('visible'); }, 80 + displayIdx * 80);
  });

  state.isTransitioning = false;
}

function selectOption(scene, chosenOption, displayedIndex) {
  if (state.isTransitioning) return;
  state.isTransitioning = true;

  const choiceEntry = {
    sceneId: scene.id, sceneTitle: scene.title,
    location: scene.location, dimension: scene.dimension, chapter: scene.chapter,
    optionId: chosenOption.id, optionText: chosenOption.text,
    score: chosenOption.score, memoryTag: chosenOption.memoryTag,
    displayedIndex
  };

  const existingIdx = state.choiceHistory.findIndex(c => c.sceneId === scene.id);
  if (existingIdx >= 0) {
    state.choiceHistory[existingIdx] = choiceEntry;
    state.choiceHistory = state.choiceHistory.slice(0, existingIdx + 1);
  } else {
    state.choiceHistory.push(choiceEntry);
  }

  // Flash selected + dim others
  const allBtns = dom.optionsContainer.querySelectorAll('.option-btn');
  allBtns.forEach((b, i) => {
    b.disabled = true;
    if (i === displayedIndex) b.classList.add('flash-select');
    else b.classList.add('dimmed');
  });

  // Card exit animation then next scene
  dom.sceneCard.classList.remove('enter');
  dom.sceneCard.classList.add('exiting');
  setTimeout(() => { state.currentSceneIndex++; renderScene(); }, 380);
}

