function renderAllTypesModal() {
  const primary = state.resultPersonality;
  const secondary = state.secondaryPersonality;
  const gap = state.confidenceGap;
  const body = $('#all-types-modal-body');
  if (!body) return;

  // Determine if secondary should be highlighted (only when gap allows showing it)
  const showSecondaryEcho = secondary && gap <= 12;

  const legendHTML = primary ? `
    <div class="all-types-legend">
      <span class="legend-item"><span class="legend-dot-sm ld-primary"></span> 你的主岛</span>
      ${showSecondaryEcho ? `<span class="legend-item"><span class="legend-dot-sm ld-secondary"></span> 关系回声</span>` : ''}
    </div>
  ` : '';

  // Core types cards (Beta 0.9.9.2 — with persona thumbnails)
  const coreTypes = personalities.filter(p => CORE_TYPE_IDS.includes(p.id));
  const coreCardsHTML = coreTypes.map(p => {
    const isPrimary = primary && p.id === primary.id;
    const isEcho = showSecondaryEcho && secondary && p.id === secondary.id;
    let cardClass = '';
    if (isPrimary) cardClass = 'highlight-primary';
    else if (isEcho) cardClass = 'highlight-secondary';

    // Persona thumbnail (Beta 0.9.9.2)
    const thumbPath = PERSONA_THUMB_MAP[p.name] || '';
    const personaAsset = PERSONA_ASSETS[p.id];
    const fallbackImg = personaAsset ? personaAsset.image : '';
    const fallbackIcon = personaAsset ? personaAsset.icon : '🏝️';
    const fallbackColor = personaAsset ? personaAsset.color : '#c9a75b';

    const thumbHTML = thumbPath ? `
      <div class="atc-thumb-wrap">
        <img class="atc-thumb-img"
             src="${thumbPath}" alt="${p.name}"
             loading="lazy" decoding="async"
             data-fallback="${fallbackImg}"
             onerror="(function(img){
               var fb = img.getAttribute('data-fallback');
               if (fb && img.src !== fb) { img.src = fb; return; }
               img.style.display='none';
               img.nextElementSibling.style.display='flex';
             })(this)" />
        <div class="atc-thumb-placeholder" style="display:none; color:${fallbackColor}">
          <span>${fallbackIcon}</span>
        </div>
      </div>` : `<div class="atc-thumb-wrap atc-thumb-noimg">
        <div class="atc-thumb-placeholder" style="display:flex; color:${fallbackColor}">
          <span>${fallbackIcon}</span>
        </div>
      </div>`;

    return `<div class="all-types-card ${cardClass}">
      ${thumbHTML}
      <div class="atc-name">${p.name}</div>
      <div class="atc-subtitle">${p.subtitle || ''}</div>
      <div class="atc-archetype">${p.archetype || ''}</div>
      <div class="atc-keywords">${(p.keywords || []).join(' / ')}</div>
    </div>`;
  }).join('');

  // Branch types cards (with parent reference)
  const branchTypes = personalities.filter(p => BRANCH_TYPE_IDS.includes(p.id));
  const branchCardsHTML = branchTypes.map(p => {
    const parentId = BRANCH_PARENT_MAP[p.id];
    const parentType = parentId ? personalities.find(pp => pp.id === parentId) : null;
    const parentName = parentType ? parentType.name : '—';

    return `<div class="all-types-card branch-card">
      <div class="atc-branch-badge">分支档案</div>
      <div class="atc-name">${p.name}</div>
      <div class="atc-subtitle">${p.subtitle || ''}</div>
      <div class="atc-archetype">${p.archetype || ''}</div>
      <div class="atc-keywords">${(p.keywords || []).join(' / ')}</div>
      <div class="atc-parent-ref">← 关联主岛：${parentName}</div>
    </div>`;
  }).join('');

  body.innerHTML = `
    <p class="all-types-intro">心岛人格图鉴收录了 12 种核心主岛人格，以及 8 种归档中的分支方向。</p>
    ${legendHTML}

    <div class="gallery-section-header">
      <span class="gallery-section-icon">🏝️</span>
      <span class="gallery-section-title">核心主岛人格</span>
      <span class="gallery-section-count">12</span>
    </div>
    <div class="all-types-grid">${coreCardsHTML}</div>

    <div class="gallery-section-divider"></div>

    <div class="gallery-section-header branch-section-header">
      <span class="gallery-section-icon">📦</span>
      <span class="gallery-section-title">分支人格档案</span>
      <span class="gallery-section-count">8</span>
    </div>
    <p class="branch-archive-note">分支人格是心岛计划后续可能展开的细分方向，当前版本不会作为你的主结果出现。它们暂时用于内部校准和未来扩展。</p>
    <div class="all-types-grid branch-grid">${branchCardsHTML}</div>
  `;
}

