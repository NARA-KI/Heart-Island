function applySceneBackground(visual) {
  if (!visual) return;
  const bg = LOCATION_BG_GRADIENTS[visual.background];
  const webpPath = SCENE_BACKGROUND_MAP[visual.dimension];

  // Beta 0.9.9.2: Apply to scene-stage elements (blurred bg + clear image)
  if (dom.sceneStage) {
    // Set CSS gradient as base on stage background
    if (dom.sceneStageBg) {
      dom.sceneStageBg.style.background = bg;
    }

    if (webpPath) {
      const img = new Image();
      img.onload = function() {
        // Blurred background layer
        if (dom.sceneStageBg) {
          dom.sceneStageBg.style.backgroundImage = `url('${webpPath}')`;
          dom.sceneStageBg.style.backgroundSize = 'cover';
          dom.sceneStageBg.style.backgroundPosition = 'center';
        }
        // Clear main image layer
        if (dom.sceneStageImage) {
          dom.sceneStageImage.src = webpPath;
        }
        dom.sceneStage.classList.add('has-scene-image');
      };
      img.onerror = function() {
        dom.sceneStage.classList.add('no-scene-image');
      };
      img.src = webpPath;
      if (img.complete && img.naturalWidth > 0) {
        if (dom.sceneStageBg) {
          dom.sceneStageBg.style.backgroundImage = `url('${webpPath}')`;
          dom.sceneStageBg.style.backgroundSize = 'cover';
          dom.sceneStageBg.style.backgroundPosition = 'center';
        }
        if (dom.sceneStageImage) {
          dom.sceneStageImage.src = webpPath;
        }
        dom.sceneStage.classList.add('has-scene-image');
      }
    }
  }

  // Update wave colors based on location
  updateBackdropForChapter(
    visual.dimension === 'CL' || visual.dimension === 'SE' || visual.dimension === 'NV' ? '启航' :
    visual.dimension === 'EX' || visual.dimension === 'RP' || visual.dimension === 'IN' ? '深入' :
    visual.dimension === 'ID' || visual.dimension === 'ST' || visual.dimension === 'CA' ? '高处' : '归航'
  );
}

function updateBackdropForChapter(chapter) {
  const meta = chapterMeta[chapter] || chapterMeta['启航'];
  updateParticleColor(meta.particleColor);
  const waves = $$('#ocean-layer .wave');
  waves.forEach((w, i) => { w.style.background = meta.gradients[i] || meta.gradients[0]; });
}

// --- Render 12-location nautical progress bar ---
function renderLocationProgress(sceneIndex) {
  if (!dom.locationProgressNodes) return;
  const currentLocIdx = getLocationProgress(sceneIndex);
  const total = LOCATION_ORDER.length;

  // Build nodes HTML on first call or when needed
  if (!dom.locationProgressNodes._built) {
    let nodesHTML = '';
    for (let i = 0; i < total; i++) {
      const loc = LOCATION_ORDER[i];
      const abbr = LOCATION_ABBR[loc] || loc.charAt(0);
      nodesHTML += `<span class="loc-node" data-loc="${i}" title="${loc}">
        <span class="loc-node-dot"></span>	        <span class="loc-node-label">${abbr}</span>
      </span>`;
    }
    dom.locationProgressNodes.innerHTML = nodesHTML;
    // Add track connector
    const track = document.createElement('div');
    track.className = 'loc-progress-track-line';
    dom.locationProgressNodes.appendChild(track);
    dom.locationProgressNodes._built = true;
  }

  // Update node states
  const nodes = dom.locationProgressNodes.querySelectorAll('.loc-node');
  nodes.forEach((node, i) => {
    node.classList.remove('active', 'passed');
    if (i < currentLocIdx) node.classList.add('passed');
    else if (i === currentLocIdx) node.classList.add('active');
  });

  // Update progress fill width
  if (dom.locationProgressFill) {
    const pct = Math.min(Math.round((sceneIndex / 36) * 100), 100);
    dom.locationProgressFill.style.width = pct + '%';
  }
}

