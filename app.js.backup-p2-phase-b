function showEndingSequence() {
  stopParticles();
  state.phase = 'ending';

  // Compute results immediately (behind the animation)
  state.avgDimensionScores = computeDimensionScores(state.choiceHistory);
  state.matchResults = matchAllTypes(state.avgDimensionScores, 'core');
  state.resultPersonality = state.matchResults[0].personality;
  state.secondaryPersonality = state.matchResults[1].personality;
  state.confidenceGap = state.matchResults[0].matchScore - state.matchResults[1].matchScore;
  state.debugAllTypeMatches = matchAllTypesDebug(state.avgDimensionScores);

  // Hide game screen, show ending screen
  dom.gameScreen.classList.add('hidden');
  if (dom.endingScreen) dom.endingScreen.classList.remove('hidden');

  // Get primary type for highlight
  const primaryType = state.resultPersonality;
  const primaryIdx = primaryType ? CORE_TYPE_IDS.indexOf(primaryType.id) : -1;

  // Phase 1: Lake backdrop darkens (0ms → 600ms)
  if (dom.endingBackdrop) {
    // Beta 0.9.9.2: Try silver-lake.webp as backdrop image
    if (RESULT_ASSET_MAP.silverLake) {
      const lakeImg = new Image();
      lakeImg.onload = function() {
        dom.endingBackdrop.style.backgroundImage = `url('${RESULT_ASSET_MAP.silverLake}')`;
        dom.endingBackdrop.style.backgroundSize = 'cover';
        dom.endingBackdrop.style.backgroundPosition = 'center';
      };
      lakeImg.src = RESULT_ASSET_MAP.silverLake;
    }
    dom.endingBackdrop.style.opacity = '0';
    requestAnimationFrame(() => {
      dom.endingBackdrop.style.transition = 'opacity 0.6s ease';
      dom.endingBackdrop.style.opacity = '1';
    });
  }

  // Phase 2: Silver ripples on lake (300ms → 1000ms)
  if (dom.endingLake) {
    const ripples = dom.endingLake.querySelectorAll('.ending-ripple');
    ripples.forEach((r, i) => {
      setTimeout(() => r.classList.add('active'), 400 + i * 200);
    });
  }

  // Phase 3: 12 location nodes light up one by one (600ms → 1800ms)
  if (dom.endingLocations) {
    const locNodes = dom.endingLocations.querySelectorAll('.ending-loc-node');
    locNodes.forEach((node, i) => {
      setTimeout(() => node.classList.add('lit'), 600 + i * 100);
    });
  }

  // Phase 4: 12 light beacons light up (1400ms → 2600ms) (Beta 0.9.9.2)
  if (dom.endingBeacons) {
    const beacons = dom.endingBeacons.querySelectorAll('.ending-beacon');
    beacons.forEach((node, i) => {
      setTimeout(() => node.classList.add('lit'), 1400 + i * 100);
    });
  }

  // Phase 5: Highlight user's primary beacon + converge route line (2600ms)
  if (primaryIdx >= 0) {
    setTimeout(() => {
      if (dom.endingBeacons) {
        const targetBeacon = dom.endingBeacons.querySelector(`.ending-beacon[data-beacon="${primaryIdx}"]`);
        if (targetBeacon) {
          targetBeacon.classList.add('highlighted');
        }
      }
      if (dom.endingRouteLine) {
        dom.endingRouteLine.classList.add('active');
      }
    }, 2600);
  }

  // Phase 6: Text reveal (2800ms)
  if (dom.endingText) {
    setTimeout(() => dom.endingText.classList.add('visible'), 2800);
  }

  // Skip button appears (1000ms)
  if (dom.endingSkipBtn) {
    dom.endingSkipBtn.style.opacity = '0';
    setTimeout(() => {
      dom.endingSkipBtn.style.opacity = '1';
      dom.endingSkipBtn.style.pointerEvents = 'all';
    }, 1000);
    dom.endingSkipBtn.onclick = () => {
      clearTimeout(state._endingTimer);
      transitionToResult();
    };
  }

  // Auto-transition to result after 3.5s (Beta 0.9.9.3: tighter pacing)
  state._endingTimer = setTimeout(() => {
    transitionToResult();
  }, 3500);
}

function transitionToResult() {
  // Clean up ending screen
  if (dom.endingScreen) dom.endingScreen.classList.add('hidden');
  // Clean up reveal (legacy fallback)
  if (dom.revealScreen) dom.revealScreen.classList.add('hidden');
  if (dom.revealRipple) dom.revealRipple.classList.remove('animating');
  if (dom.revealText) dom.revealText.classList.remove('visible');
  if (dom.revealLineArt) dom.revealLineArt.classList.remove('visible');
  if (dom.revealSkipBtn) dom.revealSkipBtn.classList.add('hidden');

  // Reset ending elements for next run
  if (dom.endingBackdrop) { dom.endingBackdrop.style.opacity = '0'; dom.endingBackdrop.style.transition = 'none'; }
  if (dom.endingLake) {
    dom.endingLake.querySelectorAll('.ending-ripple').forEach(r => r.classList.remove('active'));
  }
  if (dom.endingLocations) {
    dom.endingLocations.querySelectorAll('.ending-loc-node').forEach(n => n.classList.remove('lit'));
  }
  if (dom.endingBeacons) {
    dom.endingBeacons.querySelectorAll('.ending-beacon').forEach(n => {
      n.classList.remove('lit', 'highlighted');
    });
  }
  if (dom.endingRouteLine) dom.endingRouteLine.classList.remove('active');
  if (dom.endingText) dom.endingText.classList.remove('visible');
  if (dom.endingSkipBtn) { dom.endingSkipBtn.style.opacity = '0'; dom.endingSkipBtn.style.pointerEvents = 'none'; }

  // Beta 0.9.9.2: Preload persona image for result hero + share card
  const primary = state.resultPersonality;
  if (primary) {
    const webpPath = getPersonaImagePath(primary);
    if (webpPath) {
      preloadImage(webpPath, 4000).then(img => {
        state._personaImg = img; // cached for share card canvas
      });
    }
  }

  // Beta 0.9.9.2: Brief result-generation transition (1.8s–2.6s)
  showResultTransition(() => {
    // Show result
    dom.resultScreen.classList.remove('hidden');
    state.phase = 'result';
    renderResult();
  });
}

