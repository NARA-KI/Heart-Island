    if (e.target.closest('#debug-close-btn')) {
      const panel = $('#debug-panel');
      if (panel) panel.classList.add('hidden');
    }
  });

  // Init hidden debug panel (5x title click)
  initDebugPanel();

  // Init all-types modal (Beta 0.9.4)
  initAllTypesEntries();

  dom.resultRestartBtn.addEventListener('click', () => {
    state.phase = 'exploring';
    state.currentSceneIndex = 0;
    state.dimensionScores = {};
    state.avgDimensionScores = {};
    state.choiceHistory = [];
    state.resultPersonality = null;
    state.secondaryPersonality = null;
    state.matchResults = [];
    state.confidenceGap = 0;
    state.isTransitioning = false;
    lastLocation = null;
    dom.resultScreen.classList.add('hidden');
    dom.revealScreen.classList.add('hidden');
    dom.gameScreen.classList.remove('hidden');
    prepareOptionOrders();
    renderScene();
  });

  runIntro();
}

document.addEventListener('DOMContentLoaded', init);

// ============================================
// 19. TEST SUITE — runTests() in console
// ============================================
function runTests(numSimulations = 2000) {
  console.log('═══════════════════════════════════');
  console.log('🧪 心岛计划 Beta 0.9.3 测试套件');
  console.log(`   真实36题模拟 × ${numSimulations} 组`);
  console.log('═══════════════════════════════════');

  // ===== Helper: simulate one real 36-question journey =====
  // forcedDisplayPos: if provided, always pick the option at this display position
  function simulateOneJourney(forcedDisplayPos) {
    const choiceHistory = [];
    for (const scene of displayScenes) {
      // Generate a fresh shuffle for this scene (simulating prepareOptionOrders)
      const shuffled = shuffleArray(scene.options);
      const optIndex = (forcedDisplayPos !== undefined)
        ? forcedDisplayPos
        : Math.floor(Math.random() * 4);
      const chosen = shuffled[optIndex];
      choiceHistory.push({
        sceneId: scene.id,
        sceneTitle: scene.title,
        location: scene.location,
        dimension: scene.dimension,
        chapter: scene.chapter,
        optionId: chosen.id,
        optionText: chosen.text,
        score: chosen.score,
        memoryTag: chosen.memoryTag,
        displayedIndex: optIndex
      });
    }
    const avgs = computeDimensionScores(choiceHistory);
    const results = matchAllTypes(avgs);
    return {
      primary: results[0],
      secondary: results[1],
      gap: results[0].matchScore - results[1].matchScore,
      results,
      avgs
    };
  }

  // ===== Test 1: Self-match (targetVector → should rank #1) =====
  console.log('\n📋 Test 1: 自我匹配验证 (targetVector 输入)');
  let test1Pass = 0, test1Fail = 0;
  const selfFailures = [];
  for (const p of personalities) {
    const results = matchAllTypes(p.targetVector);
    const rank = results.findIndex(r => r.personality.id === p.id) + 1;
    if (rank === 1) {
      test1Pass++;
    } else {
      test1Fail++;
      selfFailures.push(`${p.name}: 排第${rank} (第1是${results[0].personality.name} ${results[0].matchScore}分, 自己${results[rank-1].matchScore}分)`);
    }
  }
  console.log(`  通过: ${test1Pass}/20  |  失败: ${test1Fail}/20`);
  if (selfFailures.length > 0) {
    console.log('  失败详情:');
    selfFailures.forEach(f => console.log(`    ❌ ${f}`));
  }

  // ===== Test 2: Real 36-question random simulation =====
  console.log(`\n📋 Test 2: ${numSimulations}组真实36题模拟`);

  const typeCounts = {};
  const gapBuckets = { 'gap<=5': 0, 'gap<=8': 0, 'gap<=12': 0, 'gap>12': 0 };
  personalities.forEach(p => { typeCounts[p.id] = 0; });

  for (let i = 0; i < numSimulations; i++) {
    const { primary, gap } = simulateOneJourney();
    typeCounts[primary.personality.id]++;

    if (gap <= 5) gapBuckets['gap<=5']++;
    else if (gap <= 8) gapBuckets['gap<=8']++;
    else if (gap <= 12) gapBuckets['gap<=12']++;
    else gapBuckets['gap>12']++;
  }

  // ---- 2a: Type distribution ----
  console.log('\n  📊 20种类型出现次数与占比:');
  const sorted = Object.entries(typeCounts)
    .map(([id, count]) => ({
      name: personalities.find(p => p.id === id).name,
      count,
      pct: (count / numSimulations * 100).toFixed(1) + '%'
    }))
    .sort((a, b) => b.count - a.count);
  console.table(sorted);

  // Warnings
  const under1Pct = sorted.filter(s => s.count / numSimulations < 0.01);
  const over15Pct = sorted.filter(s => s.count / numSimulations > 0.15);
  if (under1Pct.length > 0) {
    console.log('  ⚠️ 出现率 <1% 的类型:');
    under1Pct.forEach(s => console.log(`    - ${s.name}: ${s.pct}`));
  }
  if (over15Pct.length > 0) {
    console.log('  ⚠️ 出现率 >15% 的类型 (可能需要调整targetVector):');
    over15Pct.forEach(s => console.log(`    - ${s.name}: ${s.pct}`));
  }
  if (under1Pct.length === 0 && over15Pct.length === 0) {
    console.log('  ✅ 所有类型分布在 1%-15% 合理区间内');
  }

  // ---- 2b: Gap distribution ----
  console.log('\n  📏 主岛与关系回声分差分布:');
  console.log(`    gap ≤ 5:  ${gapBuckets['gap<=5']}   (${(gapBuckets['gap<=5']/numSimulations*100).toFixed(1)}%)`);
  console.log(`    gap ≤ 8:  ${gapBuckets['gap<=8']}   (${(gapBuckets['gap<=8']/numSimulations*100).toFixed(1)}%)`);
  console.log(`    gap ≤ 12: ${gapBuckets['gap<=12']}  (${(gapBuckets['gap<=12']/numSimulations*100).toFixed(1)}%)`);
  console.log(`    gap > 12: ${gapBuckets['gap>12']}   (${(gapBuckets['gap>12']/numSimulations*100).toFixed(1)}%)`);

  // ===== Test 3: Fixed displayed-position tests =====
  console.log('\n📋 Test 3: 连续点击同一显示位置（验证打乱后分数不会固定）');
  console.log('  说明：每题选项随机打乱后，"第1个位置"不再是固定选项。');

  for (const [label, displayPos] of [['始终点第1个', 0], ['始终点第2个', 1], ['始终点第3个', 2], ['始终点第4个', 3]]) {
    // Run 5 simulations per position to show variety
    const samples = [];
    for (let s = 0; s < 5; s++) {
      const { primary, avgs } = simulateOneJourney(displayPos);
      const dimSum = DIM_ORDER.reduce((sum, d) => sum + (avgs[d] || 0), 0);
      samples.push({ name: primary.personality.name, score: primary.matchScore, dimSum });
    }
    const allSame = samples.every(s => s.name === samples[0].name);
    console.log(`\n  ${label}（5次模拟）：`);
    samples.forEach((s, i) => {
      console.log(`    #${i + 1}: ${s.name}(${s.score}分) 12维总分=${s.dimSum}`);
    });
    if (allSame) {
      console.log(`    ⚠️ 5次结果完全相同 — 选项打乱可能未生效`);
    } else {
      console.log(`    ✅ 结果有变化 — 选项打乱生效`);
    }
  }

  // ===== Test 4: Detailed gap analysis on random subset =====
  console.log('\n📋 Test 4: 随机样本细节 (前10组)');
  for (let i = 0; i < 10; i++) {
    const { primary, secondary, gap, avgs } = simulateOneJourney();
    const dimSummary = DIM_ORDER.map(d => avgs[d]).join(',');
    console.log(`  #${i+1}: ${primary.personality.name}(${primary.matchScore}) / ${secondary.personality.name}(${secondary.matchScore}) gap=${gap}`);
  }

  // ===== Summary =====
  console.log('\n═══════════════════════════════════');
  console.log('✅ 测试套件完成');
  console.log('   Test 1: 自我匹配 — ' + (test1Fail === 0 ? '✅ 全部通过' : `⚠️ ${test1Fail}个失败`));
  console.log('   Test 2: 真实模拟 — 分布见上表');
  console.log('   Test 3: 固定显示位置 — 验证选项打乱');
  console.log('   Test 4: 随机样本 — 见上');
  console.log('═══════════════════════════════════');
}
