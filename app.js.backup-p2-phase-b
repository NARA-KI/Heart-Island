      // Failed
      if (previewArea) previewArea.classList.add('visible');
      if (previewImg) previewImg.style.display = 'none';
      if (errorText) errorText.classList.add('visible');
      if (saveBtn) saveBtn.classList.add('hidden');
      if (nativeBtn) nativeBtn.classList.add('hidden');
      showCopyToast('图片生成失败，请重试');
    }
  }

  // Generate share cover image
  if (coverBtn) {
    coverBtn.addEventListener('click', () => {
      try {
        shareImageDataURL = generateShareCoverImage();
        showPreview(shareImageDataURL);
        if (shareImageDataURL) showCopyToast('分享卡已生成，可保存或分享');
      } catch (e) {
        showPreview(null);
      }
    });
  }

  // Generate full report image
  if (fullBtn) {
    fullBtn.addEventListener('click', () => {
      try {
        shareImageDataURL = generateFullReportImage();
        showPreview(shareImageDataURL);
        if (shareImageDataURL) showCopyToast('长图已生成，可保存或分享');
      } catch (e) {
        showPreview(null);
      }
    });
  }

  // Save PNG
  if (saveBtn) {
    saveBtn.addEventListener('click', () => {
      if (!shareImageDataURL) return;
      const primary = state.resultPersonality;
      const filename = `heart-island-${(primary && primary.name) || 'personality'}.png`;
      const a = document.createElement('a');
      a.href = shareImageDataURL;
      a.download = filename;
      a.click();
      showCopyToast('图片已保存');
    });
  }

  // Native share
  if (nativeBtn) {
    nativeBtn.addEventListener('click', async () => {
      if (!shareImageDataURL) return;
      const primary = state.resultPersonality;
      const title = `心岛计划 · ${primary ? primary.name : '恋爱人格'}`;
      const text = primary ? primary.hitLine : '探索你的恋爱人格';

      if (navigator.share && navigator.canShare) {
        try {
          const blob = dataURLToBlob(shareImageDataURL);
          const file = new File([blob], `heart-island-${primary ? primary.name : 'share'}.png`, { type: 'image/png' });
          const shareData = { title, text, files: [file] };
          if (navigator.canShare(shareData)) {
            await navigator.share(shareData);
            return;
          }
        } catch (e) { /* fall through */ }
      }
      if (navigator.share) {
        try { await navigator.share({ title, text }); return; }
        catch (e) { /* user cancelled */ }
      }
      showCopyToast('当前浏览器不支持直接分享图片，请先保存图片后发送给朋友。');
    });
  }

  // Copy share text
  if (copyBtn) {
    copyBtn.addEventListener('click', () => { copyShareText(); });
  }
}

// ---- Share Cover Image (Beta 0.9.9.2 — with portrait image) ----
function generateShareCoverImage() {
  const primary = state.resultPersonality;
  const secondary = state.secondaryPersonality;
  const primaryScore = state.matchResults[0].matchScore;
  const secondaryScore = state.matchResults[1].matchScore;
  const kws = (primary.keywords || ['探索','真实','自由']).slice(0, 3);
  const shareQuote = primary.shareQuote || primary.hitLine || '';
  const subtitle = primary.subtitle || '';

  const W = 1080, H = 1440;
  const canvas = document.createElement('canvas');
  canvas.width = W; canvas.height = H;
  const ctx = canvas.getContext('2d');

  // Background gradient — deep sea
  const bgGrad = ctx.createRadialGradient(W * 0.3, H * 0.25, 100, W * 0.5, H * 0.6, 1200);
  bgGrad.addColorStop(0, '#162845'); bgGrad.addColorStop(0.4, '#0e2038');
  bgGrad.addColorStop(0.75, '#0b1a30'); bgGrad.addColorStop(1, '#080f20');
  ctx.fillStyle = bgGrad; ctx.fillRect(0, 0, W, H);

  // Chart grid lines (subtle)
  ctx.strokeStyle = 'rgba(201,167,91,0.04)'; ctx.lineWidth = 0.5;
  for (let gy = 0; gy < H; gy += 80) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke(); }
  for (let gx = 0; gx < W; gx += 80) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke(); }

  // Mist — softer tidal tones
  const mistGrad = ctx.createLinearGradient(0, H * 0.3, 0, H);
  mistGrad.addColorStop(0, 'rgba(74,158,155,0.05)'); mistGrad.addColorStop(0.5, 'rgba(58,125,110,0.04)');
  mistGrad.addColorStop(1, 'rgba(10,22,40,0)');
  ctx.fillStyle = mistGrad; ctx.fillRect(0, H * 0.25, W, H * 0.75);

  // Island silhouette — layered contour
  ctx.beginPath();
  ctx.moveTo(0, H * 0.55); ctx.quadraticCurveTo(W * 0.2, H * 0.42, W * 0.45, H * 0.40);
  ctx.quadraticCurveTo(W * 0.65, H * 0.37, W, H * 0.48);
  ctx.lineTo(W, H * 0.62); ctx.lineTo(0, H * 0.62); ctx.closePath();
  ctx.fillStyle = 'rgba(12,22,48,0.55)'; ctx.fill();

  // Route dots (was stars) — gold & tidal cyan
  const dotPalette = ['rgba(201,167,91,0.35)','rgba(201,167,91,0.25)','rgba(74,158,155,0.22)','rgba(201,112,124,0.15)'];
  for (let i = 0; i < 40; i++) {
    ctx.beginPath(); ctx.arc(Math.random() * W, Math.random() * H * 0.45, Math.random() * 1.8 + 0.5, 0, Math.PI * 2);
    ctx.fillStyle = dotPalette[Math.floor(Math.random() * dotPalette.length)]; ctx.fill();
  }

  // Compass rose (top left decorative)
  const cx = 140, compY = 110, cr = 35;
  ctx.beginPath(); ctx.arc(cx, compY, cr, 0, Math.PI * 2);
  ctx.strokeStyle = 'rgba(201,167,91,0.18)'; ctx.lineWidth = 1; ctx.stroke();
  ctx.beginPath(); ctx.arc(cx, compY, cr - 8, 0, Math.PI * 2);
  ctx.strokeStyle = 'rgba(201,167,91,0.08)'; ctx.stroke();
  // Cross lines
  ctx.beginPath(); ctx.moveTo(cx - cr + 6, compY); ctx.lineTo(cx + cr - 6, compY);
  ctx.moveTo(cx, compY - cr + 6); ctx.lineTo(cx, compY + cr - 6);
  ctx.strokeStyle = 'rgba(201,167,91,0.12)'; ctx.lineWidth = 0.5; ctx.stroke();
