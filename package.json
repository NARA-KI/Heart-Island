{
  "name": "heart-island",
  "version": "0.9.9.7-beta",
  "description": "心岛计划 — 沉浸式恋爱人格测试 H5",
  "private": true,
  "scripts": {
    "check": "npm run test:consistency && npm run audit:probability:live && npm run audit:options",
    "test": "npm run check",
    "audit:probability": "node scripts/probability-audit.mjs",
    "audit:probability:live": "node scripts/probability-audit.mjs --profile calibrationB",
    "audit:options": "node scripts/option-alignment-audit.mjs",
    "test:consistency": "node scripts/consistency-test.mjs",
    "ui:inspect": "node scripts/inspect-ui.mjs",
    "v2:validate": "node scripts/v2-product-validation/validate-v2-alpha.mjs",
    "v2:audit:scoring": "node scripts/v2-product-validation/diagnose-v2-calibration.mjs",
    "v2:audit:archive": "node scripts/v2-product-validation/audit-beta-archive-assets.mjs",
    "v2:audit:all": "node scripts/v2-product-validation/run-v2-audit-all.mjs",
    "v2:calibrate": "node scripts/v2-product-validation/prepare-v2-pilot-readiness.mjs",
    "v2:calibrate:adaptive-search": "node scripts/v2-product-validation/calibrate-v2-adaptive-candidate.mjs",
    "v2:calibrate:candidates": "node scripts/v2-product-validation/calibrate-v2-scoring-candidates.mjs",
    "v2:audit:calibration": "node scripts/v2-product-validation/audit-v2-calibration-candidates.mjs",
    "v2:prepare:pilot": "node scripts/v2-product-validation/prepare-v2-pilot-readiness.mjs",
    "v2:validate:pilot": "node scripts/v2-product-validation/validate-v2-pilot-readiness.mjs",
    "v2:test:result-core": "node tests/v2-result-core.test.mjs",
    "v2:test:result-core:browser": "node tests/v2-result-core-browser.mjs",
    "v2:test:feedback": "node tests/v2-feedback-config.test.mjs",
    "v2:test:ai-report": "node tests/v2-ai-report-service.test.mjs && node tests/v2-ai-report-client.test.mjs",
    "v2:test:ai-report:browser": "node tests/v2-controlled-ai-report-browser.mjs",
    "v2:test:ios-home": "node tests/v2-rc2-ios-home-viewport.test.mjs",
    "v2:test:option-readability": "node tests/v2-option-order-and-rc2-readability.test.mjs",
    "v2:test:rc2-visual": "node scripts/rc2-production-review.mjs",
    "v2:test:controlled-ai": "npm run v2:test:ai-report",
    "v2:test:controlled-ai:browser": "npm run v2:test:ai-report:browser",
    "v2:test:provider-smoke": "node scripts/v2-provider-smoke.mjs"
  },
  "type": "module",
  "dependencies": {
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "playwright": "^1.61.0",
    "prettier": "^3.8.4"
  }
}
