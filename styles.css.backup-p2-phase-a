/* ============================================ */
/* REVEAL TRANSITION                             */
/* ============================================ */
#reveal-screen {
  z-index:18; pointer-events:all;
  background:radial-gradient(circle at 50% 50%, rgba(10,25,45,0.5), rgba(6,13,31,0.92));
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:20px;
}
#reveal-ripple {
  position:absolute; width:10px; height:10px;
  border-radius:50%;
  background:transparent;
  border:1px solid rgba(232,207,140,0.3);
  opacity:0;
}
#reveal-ripple.animating {
  animation:revealRipple 1.2s var(--ease-out-expo) forwards;
}
@keyframes revealRipple {
  0% { width:10px; height:10px; opacity:0.8; }
  100% { width:200vmax; height:200vmax; opacity:0; }
}
#reveal-text {
  font-family:var(--font-title);
  font-size:clamp(15px,4vw,18px);
  color:var(--gold-glow);
  letter-spacing:3px;
  opacity:0; transform:translateY(8px);
  z-index:1;
}
#reveal-text.visible {
  animation:revealTextIn 0.7s var(--ease-out-expo) forwards;
}
@keyframes revealTextIn {
  from { opacity:0; transform:translateY(8px); }
  to { opacity:1; transform:translateY(0); }
}
#reveal-line-art {
  position:absolute; width:200px; height:1px;
  background:linear-gradient(90deg, transparent, rgba(232,207,140,0.25), transparent);
  opacity:0; z-index:0;
}
#reveal-line-art.visible {
  animation:revealLine 1s var(--ease-out-expo) forwards;
}
@keyframes revealLine {
  0% { width:0px; opacity:1; }
  70% { width:280px; opacity:0.6; }
  100% { width:300px; opacity:0; }
}
#reveal-skip-btn {
  position:relative; z-index:2;
  margin-top:30px;
  padding:8px 24px;
  min-height:44px; display:inline-flex; align-items:center;
  border:1px solid rgba(255,255,255,0.12);
  border-radius:20px;
  background:rgba(255,255,255,0.03);
  color:var(--white-faint);
  font-size:12px; letter-spacing:2px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
#reveal-skip-btn:hover { color:var(--white-dim); border-color:rgba(255,255,255,0.2); }

/* ============================================ */
/* RESULT SCREEN — Beta 0.9.4                    */
/* ============================================ */
#result-screen {
  overflow-y:auto; justify-content:flex-start;
  padding-top:28px; padding-bottom:80px;
  -webkit-overflow-scrolling:touch;
  scroll-behavior:smooth;
}

#result-card {
  width:min(920px, calc(100vw - 40px));
  max-width:920px;
  background:var(--glass-bg);
  backdrop-filter:var(--glass-blur);
  -webkit-backdrop-filter:var(--glass-blur);
  border:1px solid var(--glass-border);
  border-radius:24px;
  padding:32px 22px 28px;
  text-align:center;
  opacity:0; transform:translateY(20px);
}
#result-card.visible {
  animation:resultCardIn 0.6s var(--ease-out-expo) forwards;
}
@keyframes resultCardIn {
  from { opacity:0; transform:translateY(20px); }
  to { opacity:1; transform:translateY(0); }
}

/* Result card inner animations */
.result-section-anim {
  opacity:0; transform:translateY(14px);
}
.result-section-anim.visible {
  animation:resultSectionIn 0.45s var(--ease-out-expo) forwards;
}
@keyframes resultSectionIn {
  from { opacity:0; transform:translateY(14px); }
  to { opacity:1; transform:translateY(0); }
}

#result-personality-name {
  font-family:var(--font-title);
  font-size:clamp(26px,7vw,38px);
  color:var(--gold-glow);
  text-shadow:0 0 28px rgba(232,207,140,0.35);
  margin-bottom:6px;
  letter-spacing:5px;
}
#result-hit-line {
  font-size:clamp(13px,3.3vw,16px);
  color:var(--teal-glow);
  font-style:italic;
  margin-bottom:22px;
  line-height:1.7;
  padding:0 8px;
}

/* ---- Result Header Block ---- */
#result-header-block {
  padding:18px 14px 12px;
  background:linear-gradient(180deg, rgba(201,167,91,0.07), rgba(201,167,91,0.01));
  border-radius:16px;
  border:1px solid rgba(201,167,91,0.14);
  margin-bottom:12px;
}

/* ---- Secondary Type Block ---- */
.secondary-type-block {
  opacity:0.85;
  padding:10px 14px;
  margin-bottom:10px;
  background:rgba(90,188,185,0.02);
  border-radius:12px;
  border:1px solid rgba(90,188,185,0.06);
}
.secondary-name {
  font-family:var(--font-title);
  font-size:16px; color:var(--teal-glow);
  letter-spacing:3px; margin-bottom:4px;
}

/* ---- Type Badges ---- */
.type-badge {
  display:inline-block; padding:4px 16px; border-radius:20px;
  font-size:11px; letter-spacing:3px; margin-bottom:8px;
  font-family:var(--font-title);
}
.type-primary {
  border:1px solid rgba(201,167,91,0.35);
  color:var(--gold-glow);
  background:rgba(201,167,91,0.08);
}
.type-secondary {
  border:1px solid rgba(90,188,185,0.22);
  color:var(--teal-glow);
  background:rgba(90,188,185,0.06);
}

/* ---- Match Score Display ---- */
.match-score-display {
  font-size:13px; color:var(--white-dim); letter-spacing:1px;
  margin-bottom:10px;
}
.match-score-display .ms-number {
  font-family:var(--font-title);
  font-size:22px; color:var(--gold-glow);
  font-weight:bold;
}
.secondary-score .ms-number {
  font-size:18px; color:var(--teal-glow);
}

/* ---- Score bars ---- */
#result-scores { margin-bottom:22px; }
.score-row {
  display:flex; align-items:center; gap:10px;
  margin-bottom:7px; text-align:left;
}
.score-label {
  width:60px; font-size:12px; letter-spacing:1px;
  color:var(--white-dim); text-align:right; flex-shrink:0;
}
.score-bar-wrap {
  flex:1; height:5px; background:rgba(255,255,255,0.06);
  border-radius:3px; overflow:hidden;
}
.score-bar-fill {
  height:100%; border-radius:3px;
  transition:width 1s var(--ease-out-expo) 0.3s;
}
.score-bar-fill.s-bar { background:linear-gradient(90deg, #5abcb9, #7ee8e5); }
.score-bar-fill.f-bar { background:linear-gradient(90deg, #8b7bb5, #b8a8e0); }
.score-bar-fill.e-bar { background:linear-gradient(90deg, #c9a75b, #e8cf8c); }
.score-bar-fill.a-bar { background:linear-gradient(90deg, #c9707c, #e0a0a8); }
.score-val {
  width:32px; font-size:12px; color:var(--white-soft); text-align:left; flex-shrink:0;
}

/* ---- Result Sections ---- */
.result-section {
  text-align:left; margin-bottom:18px;
}
.result-section h3 {
  font-family:var(--font-title);
  font-size:14px; color:var(--gold);
  margin-bottom:8px; letter-spacing:2px;
  display:flex; align-items:center; gap:6px;
}
.result-section p {
  font-size:13px; line-height:1.8;
  color:var(--white-dim); padding-left:2px;
}

/* ---- Tags ---- */
#result-tags {
  display:flex; flex-wrap:wrap; gap:7px; justify-content:center; margin-bottom:20px;
}
.result-tag {
  padding:5px 14px; border-radius:20px;
  font-size:12px; letter-spacing:1px;
  border:1px solid;
}
.tag-match { border-color:var(--teal); color:var(--teal-glow); background:rgba(90,188,185,0.06); }
.tag-danger { border-color:var(--rose); color:var(--rose-glow); background:rgba(201,112,124,0.06); }

/* ---- Compatibility ---- */
#compat-section { margin-bottom:20px; text-align:left; }
#compat-section h3 {
  font-family:var(--font-title);
  font-size:14px; color:var(--gold); margin-bottom:10px;
  letter-spacing:2px; text-align:center;
}
.compat-row {
  display:flex; justify-content:space-between; align-items:center;
  padding:7px 12px; margin-bottom:4px;
  border-radius:10px;
  background:rgba(255,255,255,0.015);
  font-size:13px;
}
.compat-row .cr-name { color:var(--white-soft); }
.compat-row .cr-score { font-size:12px; }
.compat-row .cr-level { font-size:11px; color:var(--white-faint); }

/* ---- Result Actions ---- */
#result-actions {
  display:flex; gap:10px; margin-top:14px; flex-wrap:wrap; justify-content:center;
}
#result-copy-btn, #result-restart-btn {
  padding:12px 28px;
  border:1px solid rgba(201,167,91,0.25);
  border-radius:50px;
  background:rgba(201,167,91,0.04);
  color:var(--gold-glow);
  font-size:14px; letter-spacing:2px;
  cursor:pointer;
  font-family:var(--font-title);
  transition:all 0.3s ease;
  white-space:nowrap;
}
#result-copy-btn {
  border-color:rgba(90,188,185,0.25);
  color:var(--teal-glow);
  background:rgba(90,188,185,0.04);
}
#result-copy-btn:active { background:rgba(90,188,185,0.15); }
#result-restart-btn:active { background:rgba(201,167,91,0.15); }

/* ============================================ */
/* RESULT SAVE BUTTONS (Beta 0.9.4)              */
/* ============================================ */
.result-save-row {
  display:flex; gap:8px; margin-top:10px; flex-wrap:wrap; justify-content:center;
}
.result-save-btn {
  padding:10px 20px;
  min-height:44px;
  border:1px solid rgba(90,188,185,0.22);
  border-radius:20px;
  background:rgba(90,188,185,0.05);
  color:var(--teal-glow);
  font-size:12px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
.result-save-btn:active { background:rgba(90,188,185,0.15); }
.result-save-btn.clear-btn {
  border-color:rgba(201,112,124,0.22);
  background:rgba(201,112,124,0.04);
  color:var(--rose-glow);
}
.result-save-btn.clear-btn:active { background:rgba(201,112,124,0.12); }
.result-save-warning {
  font-size:10px; color:var(--white-faint);
  margin-top:6px; font-style:italic; text-align:center;
}

/* ============================================ */
/* COLLAPSE TOGGLE (Beta 0.9.4)                  */
/* ============================================ */
.collapse-toggle {
  display:block; width:100%;
  margin-top:14px; padding:10px 16px;
  min-height:44px;
  border:1px solid rgba(255,255,255,0.06);
  border-radius:12px;
  background:rgba(255,255,255,0.02);
  color:var(--white-dim);
  font-size:12px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
  text-align:center;
}
.collapse-toggle:hover {
  border-color:rgba(255,255,255,0.12);
  color:var(--white-soft);
}
.collapse-toggle:active {
  background:rgba(255,255,255,0.05);
}
.collapse-toggle .toggle-arrow {
  display:inline-block; margin-left:6px;
  transition:transform 0.3s ease;
}
.collapse-toggle.expanded .toggle-arrow {
  transform:rotate(180deg);
}
.collapse-content {
  max-height:0; overflow:hidden;
  transition:max-height 0.4s var(--ease-out-expo), opacity 0.3s ease, margin 0.3s ease;
  opacity:0; margin-top:0;
}
.collapse-content.expanded {
  max-height:20000px;
  opacity:1;
  margin-top:14px;
}

/* ============================================ */
/* ANALYSIS CARDS                                */
/* ============================================ */
.analysis-card {
  text-align:left; margin-bottom:16px;
  background:rgba(255,255,255,0.012);
  border-radius:0 12px 12px 0; padding:16px;
  border:none;
  border-left:2px solid rgba(201,167,91,0.15);
}
.analysis-card h3 {
  font-family:var(--font-title);
  font-size:14px; color:var(--gold);
  margin-bottom:8px; letter-spacing:2px;
  display:flex; align-items:center; gap:6px;
}
.analysis-card p {
  font-size:13px; line-height:1.8;
  color:var(--white-dim);
}

.analysis-row {
  display:flex; gap:10px; margin-bottom:16px;
}
.analysis-half {
  flex:1; text-align:left;
  background:rgba(255,255,255,0.015);
  border-radius:14px; padding:14px;
  border:1px solid rgba(255,255,255,0.035);
}
.analysis-half h3 {
  font-family:var(--font-title);
  font-size:13px; color:var(--gold);
  margin-bottom:6px; letter-spacing:2px;
  display:flex; align-items:center; gap:4px;
}
.analysis-half p {
  font-size:12px; line-height:1.7;
  color:var(--white-dim);
}

.subconscious-card {
  border-left:2px solid rgba(139,123,181,0.18);
  background:rgba(139,123,181,0.03);
  border-radius:0 12px 12px 0;
}
.growth-card {
  border-left:2px solid rgba(74,158,155,0.20);
  background:rgba(74,158,155,0.02);
  border-radius:0 12px 12px 0;
}
.score-reason-card {
  border-left:2px solid rgba(201,167,91,0.22);
  background:rgba(201,167,91,0.02);
  border-radius:0 12px 12px 0;
}
.score-reason-card p {
  font-size:13px; line-height:1.85; color:var(--white-dim);
  font-style:italic;
}

.final-reading-card {
  border-left:2px solid rgba(201,112,124,0.18);
  background:rgba(201,112,124,0.02);
  border-radius:0 12px 12px 0;
}
.final-reading-card .reading-paragraph {
  font-size:13px; line-height:1.9; color:var(--white-dim);
  margin-bottom:14px; text-indent:1em;
}
.final-reading-card .reading-paragraph:last-child { margin-bottom:0; }

/* Growth Plan */
.growth-plan-card h3 { margin-bottom:4px; }
.growth-plan-section {
  margin-bottom:12px; padding:10px 14px;
  background:rgba(255,255,255,0.015);
  border-radius:10px;
  border-left:3px solid;
}
.growth-plan-section:last-child { margin-bottom:0; }
.growth-plan-section.gp-short  { border-left-color:var(--teal); }
.growth-plan-section.gp-rel    { border-left-color:var(--gold); }
.growth-plan-section.gp-long   { border-left-color:var(--purple); }
.growth-plan-section .gp-label {
  font-size:12px; letter-spacing:1px; margin-bottom:4px;
  font-family:var(--font-title);
}
.growth-plan-section.gp-short  .gp-label { color:var(--teal-glow); }
.growth-plan-section.gp-rel    .gp-label { color:var(--gold-glow); }
.growth-plan-section.gp-long   .gp-label { color:var(--purple-glow); }
.growth-plan-section .gp-text {
  font-size:12px; line-height:1.7; color:var(--white-dim);
}

/* ---- Story / Journey Block ---- */
.story-block {
  text-align:left; margin-bottom:16px;
  background:rgba(255,255,255,0.02);
  border-radius:14px; padding:18px 16px;
  border:1px solid rgba(255,255,255,0.04);
}
.story-block h3 {
  font-family:var(--font-title);
  font-size:15px; color:var(--gold);
  margin-bottom:14px; letter-spacing:2px;
  text-align:center;
}
.journey-intro {
  font-size:13px; line-height:1.85; color:var(--white-dim);
  margin-bottom:14px; font-style:italic;
}
.journey-line {
  font-size:13px; line-height:1.85; color:var(--white-dim);
  margin-bottom:10px; padding-left:8px;
  border-left:2px solid rgba(201,167,91,0.18);
}
.journey-line strong { color:var(--white-soft); font-weight:500; }
.journey-closing {
  font-size:13px; line-height:1.85; color:var(--white-dim);
  margin-top:14px; font-style:italic;
}

/* ---- Toast ---- */
#copy-toast {
  position:fixed; bottom:80px; left:50%; transform:translateX(-50%) translateY(20px);
  background:rgba(15,25,45,0.95);
  border:1px solid rgba(201,167,91,0.25);
  border-radius:30px;
  padding:12px 24px; color:var(--gold-glow);
  font-size:13px; letter-spacing:1px;
  z-index:100; opacity:0; transition:all 0.4s ease;
  pointer-events:none;
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
}
#copy-toast.show { opacity:1; transform:translateX(-50%) translateY(0); }

/* ============================================ */
/* 3-SECOND SUMMARY CARD                         */
/* ============================================ */
.summary-card {
  position:relative; overflow:hidden;
  margin-bottom:18px; padding:20px 16px 16px;
  border-radius:18px;
  border:1px solid rgba(201,167,91,0.20);
  background:rgba(15,22,40,0.50);
  backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);
  text-align:center;
}
.summary-card-glow {
  position:absolute; top:-40%; left:50%; transform:translateX(-50%);
  width:160px; height:100px;
  background:radial-gradient(ellipse, rgba(201,167,91,0.05) 0%, transparent 70%);
  pointer-events:none;
}
.summary-primary, .summary-secondary {
  display:flex; align-items:center; justify-content:center;
  gap:8px; margin-bottom:2px;
}
.summary-label {
  font-size:12px; color:var(--white-faint);
  font-family:var(--font-title); letter-spacing:1.5px;
}
.summary-value {
  font-size:20px; font-weight:700; color:var(--gold);
  font-family:var(--font-title); letter-spacing:3px;
}
.summary-match {
  font-size:14px; color:var(--gold-glow); font-weight:600;
}
.summary-secondary .summary-value {
  font-size:16px; color:var(--teal-glow);
}
.summary-secondary .summary-match {
  font-size:13px; color:var(--teal);
}
.summary-keywords {
  display:flex; justify-content:center; gap:8px;
  margin:12px 0 8px;
}
.summary-kw {
  display:inline-block; padding:4px 14px;
  border-radius:14px;
  border:1px solid rgba(201,167,91,0.22);
  background:rgba(201,167,91,0.06);
  color:var(--gold-glow);
  font-size:12px; letter-spacing:1.5px;
  font-family:var(--font-title);
}
.summary-hitline {
  font-size:14px; color:var(--white-dim); font-style:italic;
  line-height:1.6; margin-bottom:10px;
  letter-spacing:0.5px;
}
.summary-confidence {
  display:flex; align-items:center; justify-content:center;
  gap:6px; flex-wrap:wrap;
  padding-top:10px;
  border-top:1px solid rgba(255,255,255,0.05);
}
.summary-conf-label {
  font-size:11px; color:var(--white-faint);
  font-family:var(--font-title); letter-spacing:1px;
}
.summary-conf-value {
  font-size:13px; font-weight:600; color:var(--gold);
  font-family:var(--font-title); letter-spacing:1px;
}
.summary-conf-note {
  display:block; width:100%; margin-top:3px;
  font-size:11px; color:var(--white-faint); letter-spacing:0.5px;
}

/* ============================================ */
/* REPORT DIVIDER                                */
/* ============================================ */
.report-divider {
  display:flex; align-items:center; gap:10px;
  margin-bottom:22px; padding:0 8px;
}
.report-divider .divider-icon { font-size:14px; color:var(--white-faint); }
.report-divider .divider-text {
  flex:1; text-align:center; font-family:var(--font-title);
  font-size:13px; color:var(--gold); letter-spacing:3px;
  position:relative;
}
.report-divider .divider-text::before,
.report-divider .divider-text::after {
  content:''; position:absolute; top:50%; width:30%;
  height:1px;
  background:linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
}
.report-divider .divider-text::before { left:0; }
.report-divider .divider-text::after { right:0; }

/* ============================================ */
/* KEY FOOTPRINTS                                */
/* ============================================ */
#key-footprints { margin-top:10px; }
.footprint-item {
  margin-bottom:14px; padding:8px 10px;
  background:rgba(255,255,255,0.012);
  border-radius:10px;
  border-left:3px solid rgba(201,167,91,0.15);
  text-align:left;
}
.footprint-item:last-child { margin-bottom:0; }
.fp-header {
  display:flex; align-items:center; gap:6px; margin-bottom:4px;
}
.fp-icon { font-size:14px; flex-shrink:0; }
.fp-location {
  font-size:13px; color:var(--white-soft); font-weight:500;
  flex:1; letter-spacing:1px;
}
.fp-score {
  font-family:var(--font-title); font-size:14px; color:var(--gold-glow);
  flex-shrink:0;
}
.fp-bar-wrap {
  height:4px; background:rgba(255,255,255,0.05);
  border-radius:2px; overflow:hidden; margin-bottom:6px;
}
.fp-bar-wrap .score-bar-fill {
  height:100%; border-radius:2px;
  transition:width 1s var(--ease-out-expo) 0.3s;
}
.fp-insight {
  font-size:12px; line-height:1.7; color:var(--white-dim);
  font-style:italic;
}

/* ---- Score Reason ---- */
.score-reason-intro {
  font-size:13px; color:var(--white-dim); margin-bottom:12px;
  text-align:left;
}
.score-reason-intro strong { color:var(--gold-glow); font-weight:500; }
.score-reason-clue {
  margin-top:14px; font-size:13px; line-height:1.8;
  color:var(--white-dim); font-style:italic;
  text-align:left;
  padding-top:10px;
  border-top:1px solid rgba(255,255,255,0.04);
}

/* ---- Sub Island Insight ---- */
.sub-island-card {
  border-left:2px solid rgba(74,158,155,0.20) !important;
  background:rgba(74,158,155,0.02) !important;
  border-radius:0 12px 12px 0 !important;
}
.sub-island-card p { font-size:13px; line-height:1.8; color:var(--white-dim); }

/* ---- Combination Portrait ---- */
.combination-card {
  border-left:2px solid rgba(201,167,91,0.22) !important;
  background:rgba(201,167,91,0.02) !important;
  border-radius:0 12px 12px 0 !important;
}
.combination-card p { font-size:13px; line-height:1.85; color:var(--white-dim); }

/* ---- Dynamic Advice ---- */
.dynamic-advice-card {
  border-left:2px solid rgba(139,123,181,0.18) !important;
  background:rgba(139,123,181,0.03) !important;
  border-radius:0 12px 12px 0 !important;
}
.dynamic-advice-card p {
  font-size:13px; line-height:1.8; color:var(--white-dim);
  font-style:italic;
}

/* ---- 12-Dimension Map ---- */
#dimension-map {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:6px;
}
.dim-card {
  background:rgba(255,255,255,0.015);
  border-radius:10px; padding:9px 10px;
  border:1px solid rgba(255,255,255,0.03);
  display:flex; flex-direction:column; gap:3px;
}
.dim-card.dim-card-primary {
  border-color:rgba(201,167,91,0.15);
  background:rgba(201,167,91,0.03);
}
.dim-card.dim-card-secondary {
  border-color:rgba(90,188,185,0.12);
  background:rgba(90,188,185,0.025);
}
.dim-card-header {
  display:flex; align-items:center; gap:4px;
  font-size:11px;
}
.dim-card-header .dim-card-icon { font-size:13px; flex-shrink:0; }
.dim-card-header .dim-card-name {
  color:var(--white-soft); font-weight:500; letter-spacing:1px;
  flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
}
.dim-card-header .dim-card-score {
  font-family:var(--font-title); font-size:14px; color:var(--gold-glow);
  flex-shrink:0;
}
.dim-card-bar-wrap {
  height:4px; background:rgba(255,255,255,0.05);
  border-radius:3px; overflow:hidden;
}
.dim-card-bar-wrap .score-bar-fill {
  height:100%; border-radius:3px;
  transition:width 1s var(--ease-out-expo) 0.4s;
}
.dim-card-primary .dim-card-name { color:var(--gold-glow); }
.dim-card-secondary .dim-card-name { color:var(--teal-glow); }

/* Map legend */
.map-legend {
  font-size:11px; color:var(--white-faint); letter-spacing:1px;
  margin-bottom:10px; display:flex; align-items:center; gap:12px;
  justify-content:center;
}
.legend-dot {
  display:inline-block; width:7px; height:7px; border-radius:50%;
  margin-right:4px; vertical-align:-1px;
}
.legend-primary { background:var(--gold-glow); box-shadow:0 0 4px var(--gold-glow); }
.legend-secondary { background:var(--teal-glow); box-shadow:0 0 4px var(--teal-glow); }

/* ---- Confidence ---- */
.confidence-card {
  border-color:rgba(201,167,91,0.12);
  background:rgba(201,167,91,0.02);
}
.confidence-text {
  font-size:13px; line-height:1.85; color:var(--white-dim);
  font-style:italic;
}
.confidence-sub {
  font-size:12px; line-height:1.7; color:var(--white-faint);
  margin-top:6px; font-style:italic;
}

/* ---- Exclusion ---- */
.exclusion-block {
  margin-top:14px; padding-top:12px;
  border-top:1px solid rgba(255,255,255,0.05);
  text-align:left;
}
.exclusion-title {
  font-size:12px; color:var(--rose); letter-spacing:1px;
  margin-bottom:8px; font-family:var(--font-title);
}
.exclusion-item {
  display:flex; gap:6px; align-items:flex-start;
  font-size:11px; line-height:1.7; color:var(--white-faint);
  margin-bottom:5px;
}
.exclusion-item .ex-dot {
  flex-shrink:0; width:5px; height:5px; border-radius:50%;
  background:var(--rose); margin-top:4px; opacity:0.4;
}

/* Complement title */
.complement-title {
  font-size:13px; color:var(--teal-glow); letter-spacing:1px;
  font-family:var(--font-title);
}

/* ============================================ */
/* SHARE IMAGE SECTION (Beta 0.9.4 — dual)       */
/* ============================================ */
.share-image-section {
  margin:24px 0 10px; text-align:center;
}
.share-divider {
  display:flex; align-items:center; gap:10px;
  margin-bottom:14px; padding:0 4px;
}
.share-divider .divider-line {
  flex:1; height:1px;
  background:linear-gradient(90deg, transparent, rgba(201,167,91,0.25), transparent);
}
.share-divider .divider-text {
  font-family:var(--font-title);
  font-size:14px; color:var(--gold-glow); letter-spacing:3px;
  white-space:nowrap;
}
.share-section-intro {
  font-size:12px; color:var(--white-faint);
  margin-bottom:16px; font-style:italic;
}
.share-buttons-row {
  display:flex; flex-wrap:wrap; gap:8px;
  justify-content:center; margin-bottom:14px;
}
.share-main-btn {
  padding:12px 28px;
  border:1px solid rgba(201,167,91,0.30);
  border-radius:24px;
  background:rgba(201,167,91,0.10);
  color:var(--gold-glow);
  font-size:14px; letter-spacing:2px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
.share-main-btn:active {
  background:rgba(201,167,91,0.20);
  transform:scale(0.97);
}
.share-sub-btn {
  padding:10px 20px;
  min-height:44px;
  border:1px solid rgba(90,188,185,0.25);
  border-radius:20px;
  background:rgba(90,188,185,0.06);
  color:var(--teal-glow);
  font-size:12px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
.share-sub-btn:active {
  background:rgba(90,188,185,0.15);
  transform:scale(0.97);
}
.share-text-btn {
  padding:8px 16px;
  min-height:44px; display:inline-flex; align-items:center;
  border:1px dashed rgba(255,255,255,0.12);
  border-radius:16px;
  background:transparent;
  color:var(--white-faint);
  font-size:11px; letter-spacing:1px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
.share-text-btn:active { background:rgba(255,255,255,0.04); }

/* Dual share buttons (Beta 0.9.4) */
.share-dual-row {
  display:flex; gap:8px; flex-wrap:wrap; justify-content:center;
  margin-bottom:10px;
}
.share-cover-btn {
  padding:10px 22px;
  min-height:44px;
  border:1px solid rgba(201,167,91,0.30);
  border-radius:20px;
  background:rgba(201,167,91,0.08);
  color:var(--gold-glow);
  font-size:12px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
.share-cover-btn:active {
  background:rgba(201,167,91,0.18);
  transform:scale(0.97);
}
.share-full-btn {
  padding:10px 22px;
  min-height:44px;
  border:1px solid rgba(90,188,185,0.25);
  border-radius:20px;
  background:rgba(90,188,185,0.06);
  color:var(--teal-glow);
  font-size:12px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
.share-full-btn:active {
  background:rgba(90,188,185,0.15);
  transform:scale(0.97);
}

.share-preview {
  margin:16px auto 0; max-width:320px;
  display:none; /* Beta 0.9.9.3: hidden by default, shown only after canvas success */
}
.share-preview.visible {
  display:block;
}
.share-preview img {
  width:100%; border-radius:12px;
  border:1px solid rgba(255,255,255,0.08);
  box-shadow:0 6px 22px rgba(0,0,0,0.22);
}
.share-error-text {
  font-size:12px; color:var(--coral-glow);
  margin-top:10px; text-align:center;
  display:none;
}
.share-error-text.visible {
  display:block;
}
.share-hint {
  font-size:10px; color:var(--white-faint);
  margin-top:10px; font-style:italic;
}

/* ---- Tags rows ---- */
.tags-row {
  display:flex; align-items:center; gap:6px;
  flex-wrap:wrap; margin-bottom:6px;
}
.tags-label {
  font-size:11px; color:var(--white-faint);
  letter-spacing:1px;
}

/* ============================================ */
/* RESONANCE SUMMARY CARD (Beta 0.9.3/4)         */
/* ============================================ */
.resonance-summary-card {
  position:relative; overflow:hidden;
  margin-bottom:22px; padding:24px 18px 18px;
  border-radius:18px;
  border:1px solid rgba(201,167,91,0.22);
  background:rgba(15,22,40,0.55);
  backdrop-filter:blur(6px);
  -webkit-backdrop-filter:blur(6px);
  text-align:center;
}
.resonance-summary-glow {
  position:absolute; top:-30%; left:50%; transform:translateX(-50%);
  width:180px; height:110px;
  background:radial-gradient(ellipse, rgba(201,167,91,0.06) 0%, transparent 70%);
  pointer-events:none;
}
.resonance-summary-type {
  display:flex; align-items:center; justify-content:center;
  gap:10px; margin-bottom:6px; flex-wrap:wrap;
}
.rs-label {
  font-size:13px; color:var(--white-faint);
  font-family:var(--font-title); letter-spacing:2px;
}
.rs-type-name {
  font-size:24px; font-weight:700; color:var(--gold);
  font-family:var(--font-title); letter-spacing:4px;
}
.rs-match-badge {
  font-size:15px; color:var(--gold-glow); font-weight:600;
  padding:2px 10px; border-radius:10px;
  background:rgba(201,167,91,0.10);
}
.resonance-summary-sub {
  display:flex; align-items:center; justify-content:center;
  gap:8px; margin-bottom:4px; opacity:0.85;
}
.rs-sub-name {
  font-size:17px; color:var(--teal-glow);
  font-family:var(--font-title); letter-spacing:3px;
}
.rs-sub-match { font-size:13px; color:var(--teal); }
.resonance-summary-kw {
  display:flex; justify-content:center; gap:8px;
  margin:14px 0 8px; flex-wrap:wrap;
}
.resonance-summary-hitline {
  font-size:15px; color:var(--white-dim); font-style:italic;
  line-height:1.7; margin-bottom:12px; padding:0 6px;
}
.resonance-summary-conf {
  font-size:12px; color:var(--white-faint);
  letter-spacing:1px; line-height:1.5;
}

/* ---- Legacy summary card compat (kept for backward compat) ---- */
.summary-card, .summary-card-glow, .summary-primary, .summary-secondary,
.summary-label, .summary-value, .summary-match, .summary-keywords,
.summary-kw, .summary-hitline, .summary-confidence, .summary-conf-value, .summary-conf-note {
  /* kept for backward compat */
}

/* ============================================ */
/* IDENTITY CARD (Beta 0.9.4 — archetype added)   */
/* ============================================ */
.identity-card {
  position:relative;
  margin-bottom:22px; padding:20px 18px 16px;
  border-radius:18px;
  border:1px solid rgba(201,167,91,0.14);
  background:linear-gradient(160deg, rgba(12,18,38,0.75), rgba(18,28,52,0.70));
  text-align:center;
}
.identity-card-badge {
  display:inline-block; padding:3px 16px; border-radius:20px;
  font-size:11px; letter-spacing:3px; margin-bottom:10px;
  font-family:var(--font-title);
  border:1px solid rgba(201,167,91,0.35);
  color:var(--gold-glow);
  background:rgba(201,167,91,0.08);
}
.identity-card-name {
  font-family:var(--font-title);
  font-size:clamp(24px,6vw,34px);
  color:var(--gold-glow);
  letter-spacing:5px;
  margin-bottom:4px;
  text-shadow:0 0 24px rgba(232,207,140,0.30);
}
.identity-card-subtitle {
  font-size:13px; color:var(--white-dim);
  margin-bottom:4px; letter-spacing:1px;
  font-style:italic;
}
.identity-card-archetype {
  display:inline-block; padding:3px 14px; border-radius:14px;
  font-size:11px; letter-spacing:2px;
  font-family:var(--font-title);
  border:1px solid rgba(139,123,181,0.25);
  color:var(--purple-glow);
  background:rgba(139,123,181,0.06);
  margin-bottom:12px;
}
.identity-card-match {
  font-size:14px; color:var(--white-dim);
  margin-bottom:12px; letter-spacing:1px;
}
.identity-card-hitline {
  font-size:14px; color:var(--teal-glow); font-style:italic;
  line-height:1.7; margin-bottom:14px; padding:0 8px;
}
.identity-card-kw {
  display:flex; justify-content:center; gap:8px;
  margin-bottom:14px; flex-wrap:wrap;
}
.identity-card-portrait {
  font-size:13px; color:var(--white-dim); line-height:1.8;
  text-align:left; padding:0 4px;
}

/* ============================================ */
/* RESONANCE MODULES                             */
/* ============================================ */
.resonance-module {
  margin-bottom:18px; padding:18px 16px;
  border-radius:16px;
  background:rgba(10,18,38,0.45);
  border:1px solid rgba(255,255,255,0.06);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
}
.resonance-module-title {
  font-family:var(--font-title);
  font-size:14px; color:var(--gold);
  letter-spacing:2px;
  margin-bottom:12px; padding-bottom:8px;
  border-bottom:1px solid rgba(201,167,91,0.10);
}
.resonance-module-text {
  font-size:13px; color:var(--white-dim);
  line-height:1.9; letter-spacing:0.3px;
}

/* ============================================ */
/* RESULT HERO (Beta 0.9.9.3 — unified with #result-hero) */
/* ============================================ */
.result-hero {
  position:relative;
  margin-bottom:28px; padding:28px 20px 20px;
  border-radius:20px;
  border:1.5px solid rgba(201,167,91,0.18);
  background:linear-gradient(160deg, rgba(15,25,48,0.85) 0%, rgba(18,30,55,0.80) 50%, rgba(12,20,38,0.85) 100%);
  text-align:left; /* Beta 0.9.9.3: left-align for two-column hero */
  box-shadow:0 0 60px rgba(201,167,91,0.06), inset 0 1px 0 rgba(255,255,255,0.03);
}
.result-hero::before {
  content:''; position:absolute; top:0; left:50%; transform:translateX(-50%);
  width:80px; height:2px;
  background:linear-gradient(90deg, transparent, var(--gold-glow), transparent);
  opacity:0.6;
}
/* These class-based hero rules are now superseded by #result-hero .hero-info-col styles */
/* Kept as fallback for any class-based usage outside #result-hero */

/* Mini island map in hero */
.mini-map-summary {
  margin-top:16px; padding:14px 12px;
  border-radius:12px;
  background:rgba(10,18,38,0.40);
  border:1px solid rgba(255,255,255,0.04);
}
.mini-map-row {
  display:flex; align-items:center; gap:8px;
  flex-wrap:wrap; justify-content:center;
}
.mini-map-row + .mini-map-row { margin-top:8px; }
.mini-map-label {
  font-size:10px; color:var(--white-faint);
  letter-spacing:2px; padding:2px 8px;
  border-radius:8px;
}
.mini-map-high .mini-map-label { background:rgba(201,167,91,0.08); color:var(--gold); }
.mini-map-low .mini-map-label  { background:rgba(110,212,208,0.06); color:var(--tidal-cyan-glow); }
.mini-map-dim {
  display:inline-flex; align-items:center; gap:3px;
  font-size:11px; color:var(--white-dim);
  padding:2px 8px; border-radius:10px;
  background:rgba(255,255,255,0.03);
}
.mmd-icon { font-size:12px; }
.mmd-name { color:var(--white-soft); }
.mmd-score { color:var(--white-faint); font-size:10px; }

/* Section dividers */
.result-section-divider {
  display:flex; align-items:center; gap:12px;
  margin:24px 0 14px; padding:0 4px;
}
.result-section-divider::before,
.result-section-divider::after {
  content:''; flex:1; height:1px;
  background:linear-gradient(90deg, transparent, rgba(201,167,91,0.12), transparent);
}
.section-divider-label {
  font-family:var(--font-title);
  font-size:12px; color:var(--gold);
  letter-spacing:4px; white-space:nowrap;
}

/* ============================================ */
/* INSIGHT MODULES (Beta 0.9.9)     */
/* ============================================ */
.insight-module {
  margin-bottom:18px; padding:18px 16px;
  border-radius:16px;
  background:rgba(10,18,38,0.38);
  border:1px solid rgba(255,255,255,0.05);
}
.insight-module-title {
  font-family:var(--font-title);
  font-size:15px; color:var(--gold);
  letter-spacing:2px;
  margin-bottom:6px;
}
.insight-module-subtitle {
  font-size:11px; color:var(--white-faint);
  margin-bottom:12px; letter-spacing:0.5px;
  font-style:italic;
}
.insight-module-text {
  font-size:13px; color:var(--white-dim);
  line-height:1.9; letter-spacing:0.3px;
}

/* ============================================ */
/* PERSONA MANUAL (Beta 0.9.9)     */
/* ============================================ */
.persona-manual {
  padding:20px 18px; border-radius:18px;
  background:linear-gradient(160deg, rgba(15,25,48,0.55), rgba(18,30,55,0.50));
  border:1.5px solid rgba(201,167,91,0.12);
  margin-bottom:18px;
}
.manual-intro {
  font-size:12px; color:var(--white-faint);
  font-style:italic; margin-bottom:18px;
  letter-spacing:0.5px; text-align:center;
}
.manual-section {
  margin-bottom:16px; text-align:left;
}
.manual-section:last-child { margin-bottom:0; }
.manual-section-title {
  font-family:var(--font-title);
  font-size:13px; color:var(--gold);
  letter-spacing:2px;
  margin-bottom:8px; padding-bottom:6px;
  border-bottom:1px solid rgba(201,167,91,0.08);
  text-align:left;
}
.manual-section-text {
  font-size:13px; color:var(--white-dim);
  line-height:2.0; letter-spacing:0.4px;
  margin:0; text-align:left;
}
.manual-why-lines {
  display:flex; flex-direction:column; gap:6px;
}
.manual-why-line {
  font-size:13px; color:var(--white-dim);
  line-height:1.9; letter-spacing:0.3px;
  margin:0; text-align:left;
}
.manual-why-line strong { color:var(--gold-glow); font-weight:500; }

/* ============================================ */
/* INERTIA MODULE (Beta 0.9.9)       */
/* ============================================ */
.inertia-module {
  padding:18px 16px; border-radius:16px;
  background:rgba(10,18,38,0.40);
  border:1px solid rgba(255,255,255,0.05);
  margin-bottom:18px;
}
.inertia-echo-top {
  font-size:11px; color:var(--white-faint);
  text-align:center; margin-bottom:14px;
  font-style:italic; opacity:0.7;
  letter-spacing:0.5px;
}
.inertia-echo-bottom {
  font-size:10px; color:var(--white-faint);
  text-align:center; margin-top:12px;
  padding-top:10px; border-top:1px solid rgba(255,255,255,0.04);
  opacity:0.55; letter-spacing:1px;
}
.inertia-sub {
  margin-bottom:14px; text-align:left;
}
.inertia-sub:last-child { margin-bottom:0; }
.inertia-sub-title {
  font-family:var(--font-title);
  font-size:13px; color:var(--tidal-cyan-glow);
  letter-spacing:2px; margin-bottom:6px;
}
.inertia-sub.inertia-caution .inertia-sub-title {
  color:var(--coral-glow);
}
.inertia-sub-text {
  font-size:13px; color:var(--white-dim);
  line-height:1.9; letter-spacing:0.3px;
  margin:0;
}

/* ============================================ */
/* COMPRESSED ADVICE (Beta 0.9.9)                */
/* ============================================ */
.advice-compact {
  padding:16px 14px; border-radius:16px;
  background:linear-gradient(135deg, rgba(12,22,36,0.45), rgba(15,28,44,0.42));
  border:1px solid rgba(74,158,155,0.10);
  margin-bottom:18px;
  display:flex; flex-direction:column; gap:12px;
}
.advice-item {
  padding:10px 12px; border-radius:10px;
  background:rgba(10,18,38,0.30);
  border-left:2px solid rgba(74,158,155,0.18);
  text-align:left;
}
.advice-label {
  display:inline-block;
  font-family:var(--font-title);
  font-size:11px; color:var(--tidal-cyan-glow);
  letter-spacing:2px; margin-bottom:4px;
  padding:1px 8px; border-radius:6px;
  background:rgba(74,158,155,0.06);
}
.advice-text {
  font-size:12px; color:var(--white-dim);
  line-height:1.8; letter-spacing:0.3px;
  margin:0;
}

/* ============================================ */
/* EXPAND-ALL SECTION (Beta 0.9.9)               */
/* ============================================ */
.expand-all-toggle {
  margin-top:0; margin-bottom:14px;
  border-color:rgba(201,167,91,0.10);
  background:rgba(15,25,44,0.35);
  flex-direction:column; align-items:flex-start;
  gap:4px; padding:12px 16px; text-align:left;
}
.expand-all-toggle .toggle-sub-text {
  display:block;
  font-size:10px; color:var(--white-faint);
  letter-spacing:0.3px; font-family:var(--font-body);
  font-style:italic; margin-top:2px;
}

/* ============================================ */
/* SHARE ID CARD SECTION (Beta 0.9.9)             */
/* ============================================ */
.share-idcard-section {
  margin:20px 0; padding:20px 16px;
  border-radius:18px;
  background:linear-gradient(160deg, rgba(15,26,46,0.55), rgba(18,30,52,0.50));
  border:1.5px solid rgba(201,167,91,0.14);
  text-align:center;
}
.share-idcard-title {
  font-family:var(--font-title);
  font-size:16px; color:var(--gold);
  letter-spacing:3px;
  margin-bottom:6px;
}
.share-idcard-subtitle {
  font-size:12px; color:var(--white-dim);
  margin-bottom:16px; letter-spacing:0.5px;
}

/* ============================================ */
/* COLLAPSE TOGGLES (Beta 0.9.9)   */
/* ============================================ */
.gallery-entry-toggle {
  margin-top:14px;
  border-color:rgba(201,167,91,0.10);
  background:rgba(15,25,44,0.35);
}
.toggle-icon {
  font-size:15px; margin-right:4px;
}

/* ============================================ */
/* COMPAT & TOP5 (Beta 0.9.9)                    */
/* ============================================ */
.compat-card { border-color:rgba(201,167,91,0.10); }
.compat-intro {
  font-size:11px; color:var(--white-faint);
  margin-bottom:10px; letter-spacing:0.5px;
}
.top5-intro {
  font-size:11px; color:var(--white-faint);
  margin-bottom:10px; letter-spacing:0.5px;
}
.map-card { border-color:rgba(74,158,155,0.10); }

/* ============================================ */
/* FEEDBACK — 给心岛写回信 (Beta 0.9.9)            */
/* ============================================ */
.feedback-section .feedback-divider {
  display:flex; align-items:center; justify-content:center;
  gap:10px; margin-bottom:10px;
}
.feedback-divider .divider-icon {
  font-size:14px; opacity:0.5;
}
.feedback-divider .divider-text {
  font-family:var(--font-title);
  font-size:13px; color:var(--gold);
  letter-spacing:3px;
}

/* ============================================ */
/* MOBILE RESULT OPTIMIZATIONS (Beta 0.9.9)      */
/* ============================================ */
@media (max-width:767px) {
  /* Hero */
  .result-hero {
    padding:22px 14px 16px;
    border-radius:16px;
  }
  .hero-island-name {
    font-size:clamp(24px,8vw,34px);
    letter-spacing:4px;
  }
  .hero-match-num {
    font-size:clamp(28px,10vw,40px);
  }
  .hero-hitline {
    font-size:14px; padding:0 4px;
  }

  /* Persona manual */
  .persona-manual {
    padding:16px 12px; border-radius:14px;
  }
  .manual-section-title {
