/* ============================================ */
/* ENDING SEQUENCE (Beta 0.9.9)                  */
/* ============================================ */
#ending-screen {
  z-index:25; pointer-events:all;
  background:#040814;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:0;
}
#ending-backdrop {
  position:absolute; inset:0;
  background:radial-gradient(ellipse at 50% 55%, rgba(30,40,80,0.6) 0%, #040814 70%);
  opacity:0; z-index:0; pointer-events:none;
}
#ending-lake {
  position:absolute; bottom:15%; left:10%; right:10%; height:30%;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:20px; z-index:1; overflow:hidden;
}
.ending-ripple {
  width:80%; max-width:300px; height:1px;
  background:linear-gradient(90deg, transparent, rgba(180,200,220,0.3), transparent);
  border-radius:50%;
  transform:scaleX(0); transition:transform 0.8s var(--ease-out-expo);
}
.ending-ripple.active { transform:scaleX(1); }
#ending-locations {
  position:absolute; bottom:25%; left:5%; right:5%;
  display:flex; justify-content:space-between;
  z-index:2; padding:0 2px;
}
.ending-loc-node {
  width:8px; height:8px; border-radius:50%;
  background:rgba(255,255,255,0.04);
  transition:all 0.6s ease;
}
.ending-loc-node.lit {
  background:rgba(201,167,91,0.7);
  box-shadow:0 0 8px rgba(201,167,91,0.5);
}
/* ---- Ending light beacons (Beta 0.9.9.2: replacing emoji constellation) ---- */
#ending-beacons {
  position:absolute; top:10%; left:50%;
  transform:translateX(-50%);
  width:300px; height:300px;
  pointer-events:none; z-index:4;
}
.ending-beacon {
  position:absolute; width:6px; height:6px;
  border-radius:50%;
  background:rgba(201,167,91,0.4);
  opacity:0; transform:scale(0.3);
  transition:all .5s cubic-bezier(0.34,1.56,0.64,1);
}
.ending-beacon:nth-child(1)  { top:0%; left:50%; }
.ending-beacon:nth-child(2)  { top:4%; left:72%; }
.ending-beacon:nth-child(3)  { top:18%; left:90%; }
.ending-beacon:nth-child(4)  { top:38%; left:98%; }
.ending-beacon:nth-child(5)  { top:58%; left:94%; }
.ending-beacon:nth-child(6)  { top:76%; left:80%; }
.ending-beacon:nth-child(7)  { top:88%; left:58%; }
.ending-beacon:nth-child(8)  { top:90%; left:36%; }
.ending-beacon:nth-child(9)  { top:80%; left:18%; }
.ending-beacon:nth-child(10) { top:60%; left:5%; }
.ending-beacon:nth-child(11) { top:38%; left:2%; }
.ending-beacon:nth-child(12) { top:18%; left:10%; }
.ending-beacon.lit {
  opacity:1; transform:scale(1);
  background:rgba(201,167,91,0.85);
  box-shadow:0 0 10px rgba(201,167,91,0.5);
}
.ending-beacon.highlighted {
  opacity:1; transform:scale(1.8);
  background:#fff;
  box-shadow:0 0 18px rgba(201,167,91,0.8), 0 0 36px rgba(201,167,91,0.4);
  z-index:5;
  animation:beaconGlow 1.5s ease-in-out infinite alternate;
}
@keyframes beaconGlow {
  from { box-shadow:0 0 12px rgba(201,167,91,0.5), 0 0 24px rgba(201,167,91,0.2); }
  to   { box-shadow:0 0 22px rgba(201,167,91,0.8), 0 0 44px rgba(201,167,91,0.4); }
}
#ending-route-line {
  position:absolute; top:50%; left:50%;
  width:200px; height:1px;
  background:linear-gradient(90deg, transparent, rgba(201,167,91,0.3), transparent);
  transform:translate(-50%,-50%) scaleX(0);
  transition:transform 1.2s cubic-bezier(0.16,1,0.3,1);
  z-index:3; pointer-events:none;
}
#ending-route-line.active {
  transform:translate(-50%,-50%) scaleX(1);
}


#ending-text {
  position:absolute; bottom:8%;
  font-family:var(--font-title);
  font-size:22px; color:var(--gold-glow);
  letter-spacing:3px;
  opacity:0; transform:translateY(10px);
  transition:all 0.8s ease;
  z-index:5;
  text-shadow:0 0 20px rgba(232,207,140,0.3);
}
#ending-text.visible { opacity:1; transform:translateY(0); }
#ending-skip-btn {
  position:absolute; bottom:24px; right:24px; z-index:10;
  padding:10px 20px;
  min-height:44px; display:inline-flex; align-items:center;
  border:1px solid rgba(201,167,91,0.3);
  border-radius:20px;
  background:rgba(10,18,36,0.75);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  color:var(--white-dim);
  font-size:13px; letter-spacing:2px;
  cursor:pointer; font-family:var(--font-title);
  opacity:0; pointer-events:none;
  transition:opacity 0.4s ease, border-color 0.3s, color 0.3s, background 0.3s;
}
#ending-skip-btn:hover {
  border-color:rgba(201,167,91,0.55);
  color:var(--gold-glow);
  background:rgba(201,167,91,0.08);
}

/* ============================================ */
/* RESULT HERO — FULL PORTRAIT LAYOUT (Beta 0.9.9.3) */
/* ============================================ */
#result-hero {
  display:flex; gap:24px; align-items:flex-start;
}
.hero-info-col {
  flex:1 1 55%; min-width:0;
}
.hero-info-col .hero-label {
  font-size:9px; text-transform:uppercase; letter-spacing:2.5px;
  color:var(--white-faint); margin-bottom:4px;
}
.hero-info-col .hero-island-name {
  font-family:var(--font-title); font-size:32px; font-weight:700;
  color:var(--white-soft); letter-spacing:2px;
  margin-bottom:6px; line-height:1.2;
}
.hero-info-col .hero-subtitle {
  font-size:12px; color:var(--white-dim); margin-bottom:14px;
  font-style:italic;
}
.hero-info-col .hero-match-row {
  display:flex; align-items:baseline; gap:8px; margin-bottom:16px;
}
.hero-info-col .hero-match-num {
  font-family:var(--font-title); font-size:44px; font-weight:700;
  color:var(--gold-glow); line-height:1;
}
.hero-info-col .hero-match-pct {
  font-size:22px; color:var(--gold-glow); opacity:0.7;
}
.hero-info-col .hero-match-label {
  font-size:11px; color:var(--white-dim); letter-spacing:1.5px;
}
.hero-info-col .hero-keywords {
  display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;
}
.hero-info-col .hero-keyword {
  display:inline-block; padding:4px 12px;
  border-radius:12px; font-size:11px; letter-spacing:1px;
  background:rgba(201,167,91,0.08); color:var(--gold-glow);
  border:1px solid rgba(201,167,91,0.12);
}
.hero-info-col .hero-hitline {
  font-size:14px; color:var(--white-soft); line-height:1.65;
  font-style:italic; margin-bottom:10px;
}
.hero-info-col .hero-confidence {
  font-size:11px; color:var(--white-faint); opacity:0.6;
}

/* Hero portrait column — Beta 0.9.9.3: strict size constraints */
.hero-portrait-col {
  flex:0 0 38%; display:flex; justify-content:center; align-items:flex-start;
}
.hero-portrait-wrap {
  width:100%; max-width:340px;
  aspect-ratio:2/3;
  max-height:510px;
  border-radius:16px; overflow:hidden;
  position:relative;
  border:1px solid rgba(201,167,91,0.2);
  background:radial-gradient(ellipse at 50% 30%, rgba(20,30,60,0.6), rgba(6,13,31,0.95));
  box-shadow:0 4px 32px rgba(0,0,0,0.5);
}
.hero-portrait-img {
  width:100%; height:100%; object-fit:cover;
  object-position:50% 18%;
  transition:opacity .5s ease;
  display:block;
}
.hero-portrait-mask {
  position:absolute; inset:0; pointer-events:none;
  background:linear-gradient(0deg, rgba(7,12,28,0.85) 0%, transparent 35%);
}
.hero-portrait-placeholder {
  position:absolute; inset:0;
  display:flex; align-items:center; justify-content:center;
  font-size:56px; opacity:0.35;
}

/* Hero badge */
.hero-badge {
  display:inline-block; padding:3px 14px;
  border-radius:10px; font-size:9px; letter-spacing:2.5px;
  text-transform:uppercase;
  background:rgba(201,167,91,0.08); color:var(--gold-glow);
  border:1px solid rgba(201,167,91,0.15);
  margin-bottom:18px;
}

