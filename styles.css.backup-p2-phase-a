/* --- Result screen background image (Beta 0.9.9.3: cover center-top no-repeat) --- */
#result-screen.has-result-bg {
  background-size: cover;
  background-position: center top;
  background-repeat: no-repeat;
  background-attachment: fixed;
  position: relative;
}
#result-screen.has-result-bg::before {
  content: "";
  position: absolute; inset: 0;
  background: rgba(7,12,28,0.82);
  z-index: 1; pointer-events: none;
}
#result-screen.has-result-bg > * {
  position: relative; z-index: 2;
}

/* --- Gallery thumbnail styles (Beta 0.9.9.2) --- */
.atc-thumb-wrap {
  width: 80px; height: 106px;
  margin: 0 auto 8px;
  border-radius: 12px;
  overflow: hidden;
  background: rgba(7,12,28,.4);
  border: 1px solid rgba(201,167,91,.15);
  flex-shrink: 0;
}
.atc-thumb-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 12px;
}
.atc-thumb-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28px;
  background: rgba(10,15,30,.3);
}
.atc-thumb-noimg .atc-thumb-placeholder {
  font-size: 24px;
}

/* Gallery cards tighten for thumbnails */
.all-types-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* --- Result generation transition screen (Beta 0.9.9.2) --- */
#reveal-screen {
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  transition: background-image .4s ease;
}
#reveal-screen::before {
  content: "";
  position: absolute; inset: 0;
  background: rgba(7,12,28,0.8);
  z-index: 1;
}
#reveal-screen > * {
  position: relative; z-index: 2;
}

/* --- Ending screen silver-lake backdrop (Beta 0.9.9.2) --- */
#ending-backdrop {
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

