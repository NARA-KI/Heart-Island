/* ============================================ */
/* 心岛计划 Heart Island — Beta 0.9.9.3            */
/* UI产品化精修版 — 首页聚焦 + 做题页重构 + 结果页宽卡 + 内容层级优化 */
/* ============================================ */

:root {
  /* ── Deep sea & nautical chart core ── */
  --bg-deep: #0a1628;
  --bg-mid: #0f2240;
  --bg-warm: #121e35;
  --sea-deep: #0c3a4a;
  --mist-purple: #5e5688;
  --mist-purple-soft: rgba(94,86,136,0.12);
  --sea-green: #3a7d6e;
  --sea-green-soft: rgba(58,125,110,0.20);

  /* ── Nautical accents: warm sand gold ── */
  --sand-gold: #c9a75b;
  --sand-gold-glow: #e8cf8c;
  --sand-gold-soft: rgba(201,167,91,0.12);

  /* ── Nautical accents: tidal cyan ── */
  --tidal-cyan: #4a9e9b;
  --tidal-cyan-glow: #6ed4d0;
  --tidal-cyan-soft: rgba(74,158,155,0.10);

  /* ── Nautical accents: coral ── */
  --coral: #c9707c;
  --coral-glow: #e0a0a8;
  --coral-soft: rgba(201,112,124,0.10);

  /* ── Text hierarchy ── */
  --white-soft: #ece6dd;
  --white-dim: rgba(236,230,221,0.55);
  --white-faint: rgba(236,230,221,0.28);
  --white-subtle: rgba(236,230,221,0.06);

  /* ── Card system: chart paper, NOT heavy glass ── */
  --card-bg: rgba(18,30,52,0.72);
  --card-border: rgba(255,255,255,0.06);
  --card-blur: blur(8px);

  /* ── Typography ── */
  --font-title: 'PingFang SC','Noto Serif SC','STSong','Songti SC',serif;
  --font-body: 'PingFang SC','Noto Sans SC','STHeiti','PingFang HK',sans-serif;
  --safe-bottom: env(safe-area-inset-bottom, 20px);

  /* ── Timing ── */
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-out-quint: cubic-bezier(0.22, 1, 0.36, 1);

  /* ── Alias old names → new nautical values (JS + legacy CSS compat) ── */
  --gold: var(--sand-gold);
  --gold-glow: var(--sand-gold-glow);
  --gold-soft: var(--sand-gold-soft);
  --teal: var(--tidal-cyan);
  --teal-glow: var(--tidal-cyan-glow);
  --teal-soft: var(--tidal-cyan-soft);
  --purple: var(--mist-purple);
  --purple-glow: #b8a8e0;
  --purple-soft: var(--mist-purple-soft);
  --rose: var(--coral);
  --rose-glow: var(--coral-glow);
  --glass-bg: var(--card-bg);
  --glass-border: var(--card-border);
  --glass-blur: var(--card-blur);
}

* { margin:0; padding:0; box-sizing:border-box; }

html, body {
  max-width:100%;
  width:100%; height:100%;
  overflow-x:hidden;
  overflow-y:auto;
  font-family:var(--font-body);
  background:var(--bg-deep);
  color:var(--white-soft);
  -webkit-tap-highlight-color:transparent;
  -webkit-font-smoothing:antialiased;
  user-select:none;
  touch-action:manipulation;
}

/* ============================================ */
/* BACKGROUND LAYERS                             */
/* ============================================ */

/* Chart texture — subtle paper grain */
#chart-texture-layer {
  position:fixed; top:0; left:0; width:100%; height:100%;
  pointer-events:none; z-index:0;
  opacity:0.035;
  background-image: url("data:image/svg+xml,%3Csvg width='200' height='200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
}

/* Gradient backdrop — soft deep sea */
#bg-gradient-layer {
  position:fixed; top:0; left:0; width:100%; height:100%;
  pointer-events:none; z-index:0;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(30,60,90,0.08), transparent 45%),
    radial-gradient(ellipse at 25% 65%, rgba(74,158,155,0.06), transparent 40%),
    radial-gradient(ellipse at 75% 45%, rgba(201,167,91,0.05), transparent 35%),
    linear-gradient(174deg, #0a1628 0%, #0e1f3a 35%, #0f1e35 65%, #0b1628 100%);
}

/* Mist layer — softer tidal haze */
#mist-layer {
  position:fixed; bottom:0; left:0; width:100%; height:50vh;
  pointer-events:none; z-index:1; opacity:0.40;
  background:
    radial-gradient(ellipse at 30% 80%, rgba(160,200,195,0.10) 0%, transparent 60%),
    radial-gradient(ellipse at 70% 70%, rgba(130,165,160,0.06) 0%, transparent 55%);
  animation:mistDrift 20s ease-in-out infinite;
}
@keyframes mistDrift {
  0%,100% { transform:translateX(0) translateY(0); }
  25% { transform:translateX(1.5%) translateY(-4px); }
  50% { transform:translateX(0) translateY(-2px); }
  75% { transform:translateX(-1.5%) translateY(-5px); }
}

/* Far island silhouette — layered contour */
#island-silhouette {
  position:fixed; bottom:0; left:50%; transform:translateX(-50%);
  width:140%; max-width:700px; height:30vh;
  pointer-events:none; z-index:1; opacity:0.14;
  background:
    radial-gradient(ellipse 80% 100% at 50% 100%, rgba(74,158,155,0.25) 0%, rgba(30,60,70,0.15) 35%, transparent 65%);
  border-radius:50% 50% 0 0;
}
#island-silhouette::after {
  content:'';
  position:absolute; bottom:0; left:0; right:0; height:40%;
  background:
    radial-gradient(ellipse 120% 100% at 50% 100%, rgba(201,167,91,0.10) 0%, transparent 60%);
  border-radius:45% 55% 0 0;
}

/* ---- Route dots (was starfield) ---- */
#starfield {
  position:fixed; top:0; left:0; width:100%; height:100%;
  pointer-events:none; z-index:1;
}
.star {
  position:absolute; border-radius:50%;
  background:var(--clr, #c9a75b);
  box-shadow:0 0 3px var(--clr, #c9a75b);
  opacity:0.12;
  animation:none;
}

/* ---- Ocean Waves — softer tidal ── */
#ocean-layer {
  position:fixed; bottom:0; left:0; width:100%; height:28vh;
  pointer-events:none; z-index:1; overflow:hidden;
}
.wave {
  position:absolute; bottom:0; width:200%; height:100%;
  border-radius:42% 42% 0 0;
  background:rgba(74,158,155,0.04);
  animation:waveDrift var(--wv-dur,8s) ease-in-out infinite;
}
.wave:nth-child(1) { animation-duration:9s; opacity:0.30; }
.wave:nth-child(2) { animation-duration:12s; opacity:0.18; animation-delay:-3s; }
.wave:nth-child(3) { animation-duration:15s; opacity:0.08; animation-delay:-6s; }
@keyframes waveDrift {
  0%,100% { transform:translateX(0) translateY(0); }
  25% { transform:translateX(-2.5%) translateY(-5px); }
  50% { transform:translateX(0) translateY(0); }
  75% { transform:translateX(2.5%) translateY(-3px); }
}

/* ---- Light Particles — softer ── */
.particle {
  position:fixed; pointer-events:none; z-index:2;
  width:2px; height:2px; border-radius:50%;
  background:var(--clr, #d4b96a);
  box-shadow:0 0 4px 1px var(--clr, #d4b96a);
  animation:floatUp var(--fp-dur) ease-in infinite;
  animation-delay:var(--fp-delay);
  opacity:0;
}
@keyframes floatUp {
  0% { opacity:0; transform:translateY(0) translateX(0) scale(0); }
  8% { opacity:0.7; transform:translateY(-8vh) translateX(3px) scale(1); }
  92% { opacity:0.25; transform:translateY(-75vh) translateX(-10px) scale(0.5); }
  100% { opacity:0; transform:translateY(-95vh) translateX(0) scale(0); }
}

/* ============================================ */
/* SCREEN CONTAINERS                             */
/* ============================================ */
.screen {
  position:fixed; top:0; left:0; width:100%; height:100%;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  z-index:10; transition:opacity 0.6s ease, visibility 0.6s ease;
  padding:24px 18px;
  padding-bottom:calc(24px + var(--safe-bottom));
}
.screen.hidden { opacity:0; visibility:hidden; pointer-events:none; }

/* ============================================ */
/* INTRO SCREEN — Beta 0.9.4                     */
/* ============================================ */
#intro-screen {
  z-index:20;
}

#intro-glow-top {
  position:absolute; top:-10%; left:50%; transform:translateX(-50%);
  width:300px; height:200px;
  background:radial-gradient(ellipse, rgba(180,160,220,0.10) 0%, transparent 70%);
  pointer-events:none; z-index:0;
  animation:introGlowBreathe 5s ease-in-out infinite;
}
@keyframes introGlowBreathe {
  0%,100% { opacity:0.6; transform:translateX(-50%) scale(1); }
  50% { opacity:1; transform:translateX(-50%) scale(1.08); }
}

#intro-compass {
  position:absolute; left:10vw; top:12vh;
  width:48px; height:48px; border-radius:50%;
  border:1px solid rgba(201,167,91,0.15);
  background:radial-gradient(circle, rgba(20,32,55,0.7) 0%, rgba(15,25,45,0.3) 100%);
  opacity:0; transition:opacity 2s ease;
  z-index:1;
}
#intro-compass::before {
  content:'+';
  position:absolute; inset:0;
  display:grid; place-items:center;
  color:var(--gold-glow);
  font-size:18px; font-weight:200; font-family:var(--font-title);
}
#intro-compass::after {
  content:'';
  position:absolute; inset:6px;
  border:1px solid rgba(201,167,91,0.08);
  border-radius:50%;
}
#intro-compass.visible { opacity:0.65; }

#intro-text-container {
  position:relative; z-index:3; text-align:center;
  opacity:0; transform:translateY(20px);
  transition:opacity 1s var(--ease-out-expo), transform 1s var(--ease-out-expo);
}
#intro-text-container.visible { opacity:1; transform:translateY(0); }

#intro-title {
  font-family:var(--font-title);
  font-size:clamp(34px,9vw,48px);
  line-height:1.1; letter-spacing:6px;
  color:var(--gold-glow);
  text-shadow:0 0 40px rgba(232,207,140,0.35), 0 0 80px rgba(232,207,140,0.10);
  margin-bottom:10px;
}
#intro-subtitle {
  font-size:clamp(13px,3.3vw,16px);
  color:var(--white-dim); letter-spacing:3px;
}

/* Intro tagline */
#intro-tagline {
  position:relative; z-index:3; text-align:center;
  margin-top:18px; max-width:320px;
  font-family:var(--font-title);
  font-size:clamp(12px,3vw,14px);
  line-height:1.9;
  color:var(--white-faint);
  letter-spacing:1.5px;
  opacity:0; transform:translateY(12px);
  transition:opacity 0.9s var(--ease-out-expo) 0.2s, transform 0.9s var(--ease-out-expo) 0.2s;
}
#intro-tagline.visible { opacity:1; transform:translateY(0); }

/* Beta badge — Beta 0.9.9.3: weakened, not in visual center */
#intro-beta-badge {
  position:fixed; top:12px; right:14px; z-index:3;
  margin:0; padding:4px 10px;
  width:fit-content;
  border:1px solid rgba(201,167,91,0.18);
  border-radius:999px;
  background:rgba(201,167,91,0.04);
  color:var(--gold);
  font-size:9px; font-weight:500; letter-spacing:0.05em;
  opacity:0; transform:translateY(4px);
  transition:opacity 0.7s ease 0.5s, transform 0.7s ease 0.5s;
}
#intro-beta-badge.visible { opacity:0.55; transform:translateY(0); }

#intro-disclaimer {
  position:relative; z-index:3;
  margin:8px auto 0; max-width:300px; text-align:center;
  padding:8px 12px;
  border:1px solid rgba(126,232,229,0.15);
  border-radius:8px;
  background:rgba(5,10,25,0.30);
  font-size:10px; line-height:1.55; color:rgba(236,230,221,0.55);
  opacity:0; transform:translateY(8px);
  transition:opacity 0.7s ease 0.1s, transform 0.7s ease 0.1s;
}
#intro-disclaimer.visible { opacity:1; transform:translateY(0); }

/* ---- Concrete subtitle (Beta 0.9.5 UI polish) ---- */
#intro-concrete-subtitle {
  position:relative; z-index:3; text-align:center;
  margin-top:12px; max-width:340px;
  font-size:clamp(11px,2.8vw,13px);
  line-height:1.7;
  color:var(--white-faint);
  letter-spacing:1px;
  opacity:0; transform:translateY(10px);
  transition:opacity 0.9s var(--ease-out-expo) 0.25s, transform 0.9s var(--ease-out-expo) 0.25s;
}
#intro-concrete-subtitle.visible { opacity:1; transform:translateY(0); }

/* ---- Selling point cards (Beta 0.9.5 / 0.9.9.3: weakened) ---- */
#intro-selling-points {
  position:relative; z-index:3;
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:6px;
  width:min(100%, 440px);
  margin:14px auto 0;
  opacity:0; transform:translateY(6px);
  transition:opacity 0.7s ease 0.15s, transform 0.7s ease 0.15s;
}
#intro-selling-points.visible { opacity:0.55; transform:translateY(0); }
.sp-card {
  display:flex; flex-direction:column; align-items:center; gap:2px;
  padding:8px 4px;
  border-radius:8px;
  border:1px solid rgba(255,255,255,0.03);
  background:rgba(15,25,45,0.2);
  text-align:center;
}
.sp-icon { font-size:15px; opacity:0.6; }
.sp-text { font-size:9px; color:var(--white-faint); line-height:1.4; }

/* ---- Saved Result Notice (Beta 0.9.4 / 0.9.9.3: weakened) ---- */
#saved-result-notice {
  position:relative; z-index:3;
  margin:18px auto 0; max-width:320px; text-align:center;
  padding:10px 14px;
  border:1px solid rgba(90,188,185,0.12);
  border-radius:12px;
  background:rgba(90,188,185,0.03);
  opacity:0; transform:translateY(8px);
  transition:opacity 0.8s ease 0.4s, transform 0.8s ease 0.4s;
}
#saved-result-notice.visible { opacity:0.7; transform:translateY(0); }
.saved-notice-text {
  font-size:12px; color:var(--teal-glow);
  margin-bottom:10px; letter-spacing:1px;
  line-height:1.6;
}
.saved-notice-time {
  font-size:10px; color:var(--white-faint);
  margin-bottom:12px; letter-spacing:0.5px;
}
.saved-notice-buttons {
  display:flex; gap:8px; justify-content:center; flex-wrap:wrap;
}
.saved-notice-btn {
  padding:8px 20px; border-radius:20px;
  font-size:12px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
  border:1px solid rgba(90,188,185,0.25);
  background:rgba(90,188,185,0.08);
  color:var(--teal-glow);
}
.saved-notice-btn:active { background:rgba(90,188,185,0.18); }
.saved-notice-btn.retake {
  border-color:rgba(201,167,91,0.25);
  background:rgba(201,167,91,0.06);
  color:var(--gold-glow);
}
.saved-notice-btn.retake:active { background:rgba(201,167,91,0.15); }
.saved-notice-warning {
  font-size:10px; color:var(--white-faint);
  margin-top:8px; font-style:italic;
}

/* ---- All Types Entry (Beta 0.9.4 / 0.9.9.3: weakened — not in visual center) ---- */
#intro-all-types-entry {
  position:relative; z-index:3;
  margin:10px auto 0;
  padding:6px 14px;
  min-height:44px; display:inline-flex; align-items:center;
  border:1px solid rgba(255,255,255,0.05);
  border-radius:16px;
  background:rgba(255,255,255,0.01);
  color:var(--white-faint);
  font-size:10px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
  opacity:0; transform:translateY(6px);
  transition:opacity 0.7s ease 0.25s, transform 0.7s ease 0.25s, background 0.3s, border-color 0.3s;
}
#intro-all-types-entry.visible { opacity:0.5; transform:translateY(0); }
#intro-all-types-entry:active {
  background:rgba(255,255,255,0.04);
  border-color:rgba(255,255,255,0.12);
  opacity:0.8;
}

/* Start button — Beta 0.9.9.3: more prominent, guaranteed above-fold */
#intro-start-btn {
  position:relative; z-index:3;
  margin-top:32px;
  width:min(100%,440px); min-height:58px;
  padding:16px 44px;
  border:1.5px solid rgba(201,167,91,0.55);
  border-radius:12px;
  background:linear-gradient(135deg, rgba(201,167,91,0.18), rgba(139,123,181,0.12));
  color:var(--gold-glow);
  font-weight:700;
  font-size:clamp(17px,4.2vw,20px);
  font-family:var(--font-title);
  letter-spacing:5px;
  cursor:pointer;
  opacity:0; transform:translateY(14px);
  transition:opacity 0.7s var(--ease-out-expo) 0.3s,
             transform 0.7s var(--ease-out-expo) 0.3s,
             background 0.35s ease,
             border-color 0.35s ease,
             box-shadow 0.35s ease;
  animation:btnBreathe 2.5s ease-in-out infinite;
  animation-play-state:paused;
  text-shadow:0 0 20px rgba(232,207,140,0.25);
}
#intro-start-btn.visible { opacity:1; transform:translateY(0); animation-play-state:running; }
#intro-start-btn:active {
  background:linear-gradient(135deg, rgba(201,167,91,0.28), rgba(139,123,181,0.20));
  border-color:rgba(232,207,140,0.7);
  box-shadow:0 0 48px rgba(201,167,91,0.22);
}
@keyframes btnBreathe {
  0%,100% { box-shadow:0 0 14px rgba(201,167,91,0.08); }
  50% { box-shadow:0 0 24px rgba(201,167,91,0.16), 0 0 40px rgba(201,167,91,0.05); }
}

/* ============================================ */
/* CHAPTER HINT OVERLAY                          */
/* ============================================ */
#chapter-hint {
  position:fixed; top:18%; left:50%; transform:translateX(-50%);
  z-index:25; pointer-events:none;
  padding:10px 24px;
  border-radius:12px;
  background:rgba(10,16,38,0.75);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,0.06);
  font-family:var(--font-title);
  font-size:13px; letter-spacing:2px;
  color:var(--white-dim);
  text-align:center;
  opacity:0; transform:translateX(-50%) translateY(-10px);
  transition:opacity 0.5s var(--ease-out-expo), transform 0.5s var(--ease-out-expo);
  white-space:nowrap;
  box-shadow:0 8px 32px rgba(0,0,0,0.2);
}
#chapter-hint.visible {
  opacity:1; transform:translateX(-50%) translateY(0);
}

/* ============================================ */
/* ============================================ */
/* GAME SCREEN (Beta 0.9.9 — 12地点场景系统)      */
/* ============================================ */
#game-screen {
  display:flex; flex-direction:column;
  align-items:stretch;
  justify-content:flex-start;
  padding:0;
  height:100vh; height:100dvh;
  overflow:hidden;
}

/* ---- Scene Top Bar ---- */
#scene-top-bar {
  position:relative; z-index:10;
  flex:0 0 auto;
  padding:max(10px, env(safe-area-inset-top)) 16px 8px;
  background:linear-gradient(180deg, rgba(6,13,31,0.95) 0%, rgba(6,13,31,0.7) 80%, transparent 100%);
}
#scene-location-row {
  display:flex; align-items:baseline; justify-content:space-between;
  margin-bottom:10px;
}
#scene-location-name {
  font-family:var(--font-title);
  font-size:clamp(15px,3.5vw,20px);
  color:var(--white-soft);
  letter-spacing:1.5px;
}
#scene-dimension-label {
  font-size:11px; color:var(--teal);
  letter-spacing:2px; font-family:var(--font-title);
}
#scene-question-counter {
  font-size:11px; color:var(--white-faint);
  font-family:var(--font-title); letter-spacing:1px;
}

/* ---- 12-Location Progress Bar ---- */
#location-progress-bar {
  position:relative; width:100%; padding:0 2px;
}
#location-progress-track {
  position:relative; width:100%; height:2px; border-radius:99px;
  background:rgba(255,255,255,0.06);
  margin-bottom:8px; overflow:visible;
}
#location-progress-fill {
  display:block; height:100%; border-radius:inherit;
  background:linear-gradient(90deg, var(--teal), var(--gold), var(--rose));
  width:0%; transition:width 0.5s var(--ease-out-expo);
}
#location-progress-nodes {
  display:flex; justify-content:space-between;
  align-items:flex-start; position:relative;
}
.loc-node {
  display:flex; flex-direction:column; align-items:center;
  gap:2px; position:relative; z-index:1;
  flex:0 0 auto; width:0;
}
.loc-node-dot {
  width:6px; height:6px; border-radius:50%;
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.10);
  transition:all 0.5s ease; flex-shrink:0;
}
.loc-node.active .loc-node-dot {
  background:var(--gold-glow);
  border-color:rgba(201,167,91,0.5);
  box-shadow:0 0 8px rgba(201,167,91,0.4);
  animation:locNodePulse 3s ease-in-out infinite;
}
.loc-node.passed .loc-node-dot {
  background:rgba(201,167,91,0.4);
  border-color:rgba(201,167,91,0.25);
}
@keyframes locNodePulse {
  0%,100% { box-shadow:0 0 6px rgba(201,167,91,0.3); }
  50%     { box-shadow:0 0 14px rgba(201,167,91,0.5); }
}
.loc-node-icon {
  font-size:8px; opacity:0.5; transition:opacity 0.5s ease;
}
.loc-node.active .loc-node-icon { opacity:0.9; }
.loc-node.passed .loc-node-icon { opacity:0.7; }
.loc-node-label {
  font-size:7px; color:var(--white-faint);
  letter-spacing:0.5px; opacity:0;
  transition:opacity 0.3s ease;
}
.loc-node.active .loc-node-label { opacity:0.8; color:var(--gold-glow); }

/* ---- Scene Visual Area ---- */
/* ---- Scene Stage (Beta 0.9.9.3: 42-46% desktop, 28vh mobile) ---- */
#scene-stage {
  position:relative; overflow:hidden;
  display:none; /* hidden by default, shown on desktop */
}
.scene-stage-bg {
  position:absolute; inset:0;
  background-size:cover; background-position:center;
  opacity:0.22; filter:blur(18px) saturate(1.2);
  transform:scale(1.1); transition:opacity .35s ease;
  z-index:0;
}
.scene-stage-image {
  position:absolute; inset:0;
  width:100%; height:100%;
  object-fit:cover; object-position:center;
  opacity:0.85; z-index:1;
  transition:opacity .35s ease;
  filter:drop-shadow(0 0 24px rgba(0,0,0,0.3));
}
.scene-stage-overlay {
  position:absolute; inset:0; z-index:2;
  background:linear-gradient(180deg, rgba(7,12,28,.15) 0%, rgba(7,12,28,.55) 100%);
  pointer-events:none;
}
.scene-stage-meta {
  position:absolute; top:16px; left:16px; right:16px; z-index:3;
  display:flex; flex-direction:column; gap:6px;
  pointer-events:none;
}
.scene-stage-meta #scene-location-name {
  font-family:var(--font-title); font-size:20px; font-weight:600;
  color:var(--white-soft); letter-spacing:2px;
  text-shadow:0 1px 8px rgba(0,0,0,0.5);
}
.scene-stage-meta #scene-dimension-label {
  font-size:10px; color:var(--white-dim); letter-spacing:1.5px;
  text-transform:uppercase; opacity:0.7;
}
.scene-stage-meta #location-progress-nodes {
  margin-top:4px;
}

/* ---- Scene Question Column (Beta 0.9.9.3: right side 54-58%) ---- */
#scene-question-column {
  position:relative; z-index:5;
  display:flex; flex-direction:column;
  overflow-y:auto; overflow-x:hidden;
}
#scene-question-column #scene-top-bar {
  display:flex; align-items:center; justify-content:space-between;
  padding:12px 16px 8px;
}
#scene-question-column #scene-question-counter {
  font-family:var(--font-title); font-size:11px;
  color:var(--white-dim); letter-spacing:2px;
}
#scene-question-column #location-progress-bar {
  flex:0 0 auto; width:120px;
}

/* ---- Scene Question Area ---- */
#scene-question-area {
  position:relative; z-index:5; flex:0 0 auto;
  padding:0 16px 16px;
  display:flex; flex-direction:column; align-items:center;
}

/* ---- Previous Button (fixed position) ---- */
#prev-btn {
  position:fixed; bottom:16px; left:16px; z-index:20;
  display:inline-flex; align-items:center; gap:4px;
  padding:6px 14px;
  border:1px solid rgba(255,255,255,0.06);
  border-radius:14px;
  background:rgba(6,13,31,0.8);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  color:var(--white-dim);
  font-size:10px; letter-spacing:1.5px;
  cursor:pointer; font-family:var(--font-title);
  transition:all 0.3s ease;
}
#prev-btn:hover {
  border-color:rgba(201,167,91,0.2);
  color:var(--white-soft);
  background:rgba(201,167,91,0.06);
}
#prev-btn:active { transform:scale(0.97); }
#prev-btn.hidden { display:none; }

/* ============================================ */
/* RIGHT: VOYAGE LOG PANEL                       */
/* ============================================ */
#voyage-log-panel {
  flex:1 1 60%;
  display:flex; flex-direction:column;
  padding:12px 24px 20px;
  overflow-y:auto;
  overflow-x:hidden;
}

/* -- Voyage Log Header -- */
#voyage-log-header {
  display:flex; align-items:baseline; gap:10px;
  margin-bottom:14px;
  padding-bottom:8px;
  border-bottom:1px solid rgba(255,255,255,0.04);
}
#voyage-log-label {
  font-family:var(--font-title);
  font-size:13px; color:var(--gold-glow);
  letter-spacing:2px; opacity:0.8;
}
#voyage-log-subtitle {
  font-size:10px; color:var(--white-faint);
  letter-spacing:1px;
}

/* ---- Scene Card (Beta 0.9.9.3: rgba dark bg + backdrop-filter blur) ---- */
#scene-card {
  position:relative; z-index:2;
  width:100%; max-width:620px;
  margin:0;
  padding:28px 24px 22px;
  background:rgba(10,18,36,0.62);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  border:1px solid rgba(255,255,255,0.07);
  border-top:2px solid rgba(201,167,91,0.12);
  border-radius:14px;
  box-shadow:0 6px 32px rgba(0,0,0,0.25);
  opacity:0; transform:translateX(24px);
}
#scene-card::before {
  content:'';
  position:absolute; inset:0; border-radius:inherit;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(255,255,255,0.005) 3px, rgba(255,255,255,0.005) 4px),
    repeating-linear-gradient(90deg, transparent, transparent 80px, rgba(201,167,91,0.015) 80px, rgba(201,167,91,0.015) 81px);
  pointer-events:none; z-index:0;
}
#scene-card.enter {
  animation:sceneEnter 0.35s var(--ease-out-expo) forwards;
}
#scene-card.exiting {
  animation:sceneExit 0.25s ease-in forwards;
}
@keyframes sceneEnter {
  from { opacity:0; transform:translateX(24px); }
  to   { opacity:1; transform:translateX(0); }
}
@keyframes sceneExit {
  from { opacity:1; transform:translateX(0); }
  to   { opacity:0; transform:translateX(-16px); }
}

/* ---- Scene Mood ---- */
#scene-mood {
  font-size:10px; color:var(--white-faint);
  margin-bottom:8px; letter-spacing:1.5px;
  text-align:left;
}

/* ---- Scene Title (left-aligned for log feel) ---- */
#scene-title {
  font-family:var(--font-title);
  font-size:clamp(20px,5vw,28px);
  line-height:1.3; letter-spacing:1.2px;
  color:var(--white-soft);
  margin-bottom:12px; text-align:left;
}

/* ---- Scene Narrative (left-aligned, more readable) ---- */
#scene-narrative {
  font-family:var(--font-title);
  font-size:clamp(14px,3.2vw,16px);
  line-height:1.9; color:rgba(236,230,221,0.68);
  margin-bottom:26px; text-align:left;
  padding:0;
}

/* ---- Options Container ---- */
#options-container {
  display:grid; gap:10px;
}

/* ---- Choice Buttons — "选择航线" cards ---- */
.option-btn {
  width:100%; max-width:100%;
  min-height:54px;
  padding:13px 14px;
  border:1px solid rgba(255,255,255,0.07);
  border-left:3px solid rgba(255,255,255,0.06);
  border-radius:8px;
  background:linear-gradient(135deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01)),
    rgba(10,16,36,0.5);
  box-shadow:0 6px 20px rgba(0,0,0,0.12);
  color:var(--white-soft);
  font-size:clamp(13px,3.2vw,15px);
  font-family:var(--font-body);
  text-align:left; cursor:pointer;
  line-height:1.6;
  display:flex; align-items:center; gap:10px;
  transition:transform 0.22s var(--ease-out-expo),
             border-color 0.22s ease,
             border-left-color 0.22s ease,
             background 0.22s ease,
             box-shadow 0.22s ease,
             opacity 0.22s ease;
  position:relative; overflow:hidden;
  opacity:0; transform:translateX(12px);
}
.option-btn.visible {
  opacity:1; transform:translateX(0);
}
/* Route number badge */
.option-btn .route-number {
  display:flex; align-items:center; justify-content:center;
  width:26px; height:26px; min-width:26px;
  border-radius:50%;
  border:1px solid rgba(255,255,255,0.10);
  font-size:11px; font-weight:600;
  color:var(--white-faint);
  font-family:var(--font-title);
  flex-shrink:0;
}
/* Route beacon dot */
.option-btn .route-beacon {
  display:block; width:6px; height:6px; min-width:6px;
  border-radius:50%;
  background:rgba(255,255,255,0.08);
  transition:all 0.3s ease;
  flex-shrink:0;
}
/* Option text */
.option-btn .opt-text {
  flex:1;
  line-height:1.55;
}
/* Route trail arrow */
.option-btn .route-trail {
  font-size:14px; color:var(--white-faint);
  opacity:0; transition:opacity 0.3s ease, color 0.3s ease;
  flex-shrink:0;
}
.option-btn:hover {
  border-color:rgba(255,255,255,0.12);
  border-left-color:rgba(201,167,91,0.25);
  background:linear-gradient(135deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02)),
    rgba(12,20,38,0.6);
  transform:translateX(3px);
}
.option-btn:hover .route-trail {
  opacity:0.5;
  color:var(--gold-glow);
}
.option-btn:hover .route-beacon {
  background:rgba(201,167,91,0.4);
}
.option-btn:active {
  transform:scale(0.985);
}

/* Selected feedback — "航线已选择" */
.option-btn.flash-select {
  border-color:rgba(201,167,91,0.55) !important;
  border-left:3px solid rgba(201,167,91,0.7) !important;
  background:linear-gradient(135deg, rgba(201,167,91,0.14), rgba(74,158,155,0.06)),
    rgba(10,20,38,0.65) !important;
  box-shadow:0 0 20px rgba(201,167,91,0.08);
  transform:translateX(2px);
}
.option-btn.flash-select .route-number {
  border-color:rgba(201,167,91,0.4);
  color:var(--gold-glow);
}
.option-btn.flash-select .route-beacon {
  background:var(--gold-glow);
  box-shadow:0 0 8px rgba(201,167,91,0.5);
}
.option-btn.flash-select .route-trail {
  opacity:0.7;
  color:var(--gold-glow);
}

/* Unselected options fade — natural, no grayscale */
.option-btn.dimmed {
  opacity:0.3;
  filter:none;
  pointer-events:none;
  border-left-color:rgba(255,255,255,0.03);
}

/* ---- Keep old .opt-icon for JS compat (hidden, JS builds innerHTML) ---- */
.option-btn .opt-icon { display:none; }

/* ============================================ */
/* DIMENSION ISLAND VISUALS (12 classes)         */
/* ============================================ */

/* CL — 靠近海岸: warm sand, shoreline */
.dim-cl #island-symbol {
  opacity:0.32;
  background:
    radial-gradient(ellipse at 50% 75%, rgba(201,167,91,0.18), transparent 45%),
    radial-gradient(ellipse at 50% 60%, rgba(201,167,91,0.10), transparent 50%),
    radial-gradient(ellipse at 50% 65%, rgba(90,188,185,0.08), transparent 60%);
}
.dim-cl #island-symbol::after {
  inset:30% 25% 50% 25%;
  border-radius:50%;
  border:1px solid rgba(201,167,91,0.12);
  background:transparent;
}

/* AU — 边界山脊: mountain silhouette */
.dim-au #island-symbol {
  opacity:0.3;
  background:
    linear-gradient(175deg, rgba(180,200,220,0.06), transparent 50%),
    radial-gradient(ellipse at 50% 50%, rgba(180,200,220,0.10), transparent 55%);
}
.dim-au #island-symbol::before {
  inset:25% 20% 40% 20%;
  border:none;
  border-radius:0;
  clip-path:polygon(0% 100%, 20% 20%, 40% 60%, 60% 5%, 80% 50%, 100% 100%);
  background:rgba(180,200,220,0.08);
}

/* SE — 回声港湾: concentric echo rings */
.dim-se #island-symbol {
  opacity:0.35;
  background:
    radial-gradient(circle, rgba(74,158,155,0.10) 0%, transparent 30%),
    radial-gradient(circle, rgba(74,158,155,0.06) 0%, transparent 50%),
    radial-gradient(circle, rgba(74,158,155,0.04) 0%, transparent 70%);
}
.dim-se #island-symbol::before {
  inset:22%; border:1px solid rgba(74,158,155,0.10); border-radius:50%;
}
.dim-se #island-symbol::after {
  inset:40%;
  border:1px dashed rgba(74,158,155,0.10);
  border-radius:50%;
  background:transparent;
}

/* EX — 潮汐河流: flowing wave lines */
.dim-ex #island-symbol {
  opacity:0.3;
  background:
    repeating-linear-gradient(0deg, transparent, transparent 14px, rgba(74,158,155,0.06) 14px, rgba(74,158,155,0.06) 15px),
    radial-gradient(ellipse at 50% 60%, rgba(74,158,155,0.10), transparent 55%);
}

/* RP — 裂隙火山: dark red fissure */
.dim-rp #island-symbol {
  opacity:0.3;
  background:
    radial-gradient(circle at 50% 70%, rgba(200,100,70,0.15), transparent 40%),
    linear-gradient(175deg, rgba(30,10,20,0.2), transparent 50%);
}
.dim-rp #island-symbol::before {
  inset:30% 40% 25% 40%;
  border:none; border-radius:0;
  clip-path:polygon(45% 0%, 55% 0%, 52% 100%, 48% 100%);
  background:linear-gradient(180deg, rgba(200,100,70,0.12), rgba(200,100,70,0.02));
}

/* IN — 风向平原: wind streaks */
.dim-in #island-symbol {
  opacity:0.28;
  background:
    linear-gradient(160deg, rgba(200,200,210,0.02) 0%, transparent 30%),
    radial-gradient(ellipse at 40% 55%, rgba(180,200,210,0.10), transparent 55%);
}
.dim-in #island-symbol::before {
  inset:20% 40% 20% 20%;
  border:none; border-radius:0;
  background:repeating-linear-gradient(25deg, transparent, transparent 8px, rgba(200,210,220,0.04) 8px, rgba(200,210,220,0.04) 9px);
}

/* ID — 星眠天文台: star points + crosshair */
.dim-id #island-symbol {
  opacity:0.3;
  background:
    radial-gradient(circle at 30% 35%, rgba(232,207,140,0.08) 0%, transparent 8%),
    radial-gradient(circle at 65% 30%, rgba(232,207,140,0.06) 0%, transparent 6%),
    radial-gradient(circle at 45% 55%, rgba(232,207,140,0.05) 0%, transparent 5%),
    radial-gradient(circle at 55% 70%, rgba(139,123,181,0.08), transparent 45%);
}
.dim-id #island-symbol::before {
  inset:28%;
  border:none;
  background:
    linear-gradient(90deg, transparent 48%, rgba(255,255,255,0.04) 48%, rgba(255,255,255,0.04) 52%, transparent 52%),
    linear-gradient(0deg, transparent 48%, rgba(255,255,255,0.04) 48%, rgba(255,255,255,0.04) 52%, transparent 52%);
  border-radius:50%;
}

/* ST — 誓约之塔: tower + steps */
.dim-st #island-symbol {
  opacity:0.3;
  background:
    radial-gradient(ellipse at 50% 70%, rgba(201,167,91,0.10), transparent 50%);
}
.dim-st #island-symbol::before {
  inset:20% 38% 30% 38%;
  border:none; border-radius:0;
  background:linear-gradient(180deg, rgba(201,167,91,0.12) 0%, rgba(201,167,91,0.04) 100%);
}
.dim-st #island-symbol::after {
  inset:55% 30% 20% 30%;
  border:none; border-radius:0;
  background:repeating-linear-gradient(0deg, transparent, transparent 5px, rgba(201,167,91,0.06) 5px, rgba(201,167,91,0.06) 6px);
}

/* CA — 灯火码头: warm light dots */
.dim-ca #island-symbol {
  opacity:0.35;
  background:
    radial-gradient(circle at 35% 55%, rgba(232,180,120,0.10) 0%, transparent 14%),
    radial-gradient(circle at 55% 45%, rgba(232,180,120,0.08) 0%, transparent 12%),
    radial-gradient(circle at 45% 65%, rgba(232,180,120,0.06) 0%, transparent 10%),
    radial-gradient(circle at 60% 58%, rgba(200,140,100,0.08) 0%, transparent 11%),
    radial-gradient(ellipse at 50% 60%, rgba(200,140,100,0.06), transparent 55%);
}

/* NV — 迷雾航线: fog overlay */
.dim-nv #island-symbol {
  opacity:0.25;
  background:
    linear-gradient(180deg, rgba(160,170,185,0.08) 0%, rgba(160,170,185,0.04) 40%, transparent 70%),
    radial-gradient(ellipse at 45% 50%, rgba(160,170,185,0.06), transparent 60%);
}
.dim-nv #island-symbol::before {
  inset:15%; border-radius:50%;
  border:none;
  background:radial-gradient(ellipse at 50% 50%, rgba(180,190,200,0.06), transparent 70%);
}

/* ME — 旧船湾: boat silhouette */
.dim-me #island-symbol {
  opacity:0.3;
  background:
    radial-gradient(ellipse at 50% 65%, rgba(139,123,181,0.10), transparent 55%);
}
.dim-me #island-symbol::before {
  inset:35% 30% 35% 30%;
  border:none; border-radius:0;
  clip-path:polygon(10% 70%, 40% 30%, 90% 30%, 90% 70%, 70% 100%, 30% 100%);
  background:rgba(139,123,181,0.10);
}

/* EV — 月潮湖: moon reflection + tide */
.dim-ev #island-symbol {
  opacity:0.32;
  background:
    radial-gradient(circle at 50% 30%, rgba(232,207,140,0.10) 0%, transparent 20%),
    radial-gradient(ellipse at 50% 65%, rgba(200,180,210,0.08), transparent 50%);
}
.dim-ev #island-symbol::before {
  inset:20% 35% 55% 35%;
  border-radius:50%;
  border:1px solid rgba(232,207,140,0.08);
  background:radial-gradient(circle, rgba(232,207,140,0.06), transparent 60%);
}
.dim-ev #island-symbol::after {
  inset:50% 25% 30% 25%;
  border-radius:50%;
  border:none;
  background:repeating-linear-gradient(0deg, transparent, transparent 4px, rgba(200,180,210,0.04) 4px, rgba(200,180,210,0.04) 5px);
}

